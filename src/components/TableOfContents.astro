---
interface Props {
  headings: { depth: number; slug: string; text: string }[];
}

const { headings } = Astro.props;

// Only show ToC if there are 3+ h2 headings
const h2Headings = headings.filter(h => h.depth === 2);
if (h2Headings.length < 3) return null;
---

{h2Headings.length >= 3 && (
  <details class="toc">
    <summary class="toc-title">Contents <span class="toc-count">{h2Headings.length} sections</span></summary>
    <ol>
      {headings.filter(h => h.depth === 2 || h.depth === 3).map(heading => (
        <li class={`toc-item toc-depth-${heading.depth}`}>
          <a href={`#${heading.slug}`}>{heading.text}</a>
        </li>
      ))}
    </ol>
  </details>
)}

<style>
  .toc {
    background: rgba(0,0,0,0.02);
    border: 1px solid var(--line);
    border-radius: 0.75rem;
    padding: 1.25rem 1.5rem;
    margin-bottom: 2rem;
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme]) .toc {
      background: rgba(255,255,255,0.04);
    }
  }

  [data-theme="dark"] .toc {
    background: rgba(255,255,255,0.04);
  }

  /* One line until you open it, so the article starts on the first screen */
  .toc {
    padding: 0;
  }
  .toc-title {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.95rem 1.25rem;
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--ink-muted);
    cursor: pointer;
    list-style: none;
  }
  .toc-title::-webkit-details-marker {
    display: none;
  }
  .toc-title::after {
    content: "";
    width: 0.45rem;
    height: 0.45rem;
    margin-left: auto;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: translateY(-2px) rotate(45deg);
    transition: transform 0.25s ease-out;
  }
  .toc[open] .toc-title::after {
    transform: translateY(2px) rotate(-135deg);
  }
  .toc-count {
    font-family: var(--font-mono);
    font-weight: 400;
    text-transform: none;
    letter-spacing: 0;
    font-size: 0.75rem;
  }
  .toc > ol {
    padding: 0 1.25rem 1.1rem !important;
  }

  .toc ol {
    list-style: none;
    padding: 0;
    margin: 0;
    counter-reset: none;
  }

  .toc ol > li::before {
    content: none;
  }

  .toc-item {
    margin-bottom: 0.35rem;
  }

  .toc-item a {
    color: var(--foreground);
    text-decoration: none;
    font-size: 0.9rem;
    line-height: 1.5;
    transition: color 0.15s;
  }

  .toc-item a:hover {
    color: var(--accent);
  }

  .toc-depth-3 {
    margin-left: 1rem;
    font-size: 0.85rem;
  }

  .toc-depth-3 a {
    color: var(--ink-muted);
    font-size: 0.85rem;
  }

  @media (min-width: 1200px) {
    .toc {
      display: none;
    }
  }
</style>
