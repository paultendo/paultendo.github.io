---
// Mermaid.astro — client-side Mermaid diagram renderer
// Usage: <Mermaid chart={`flowchart LR\n  A --> B`} />
//
// Styling: Mermaid classDef only supports fill/stroke/color. This component
// layers CSS on top of the rendered SVG to add glassy effects, glow, rounded
// corners, and shadows that match the site theme. Use these classDef names
// in your diagram and the CSS below handles the rest:
//
//   :::muted   — subdued node (input/output steps)
//   :::logic   — green-accented node (deterministic / rules)
//   :::llm     — blue-accented node (AI / generative)
//   :::accent  — site accent highlight
//   :::danger  — red warning node
//
interface Props {
  chart: string;
}

const { chart } = Astro.props;
---

<div class="mermaid-wrapper" data-chart={chart}>
  <pre class="mermaid"></pre>
</div>

<script>
  const darkVars = {
    fontSize: '14px',
    fontFamily: 'Instrument Sans, system-ui, sans-serif',
    primaryColor: '#141f2e',
    primaryTextColor: '#cdd8e8',
    primaryBorderColor: '#253347',
    lineColor: '#3a5068',
    edgeLabelBackground: '#0e1520',
  };

  const lightVars = {
    fontSize: '14px',
    fontFamily: 'Instrument Sans, system-ui, sans-serif',
    primaryColor: '#e8edf4',
    primaryTextColor: '#1a2a3c',
    primaryBorderColor: '#c2cfe0',
    lineColor: '#8a9bb5',
    edgeLabelBackground: '#f4f6f9',
  };

  // classDef palettes — injected by the component so posts only use :::className
  const classDefs = {
    dark: [
      'classDef muted fill:#141f2e,stroke:#253347,color:#8899aa,stroke-width:1px',
      'classDef logic fill:#0a2e1a,stroke:#1ed760,color:#4ddf80,stroke-width:2px',
      'classDef llm fill:#0c1836,stroke:#3f79ff,color:#7da3ff,stroke-width:2px',
      'classDef accent fill:#0a2e1a,stroke:#1ed760,color:#4ddf80,stroke-width:2px',
      'classDef danger fill:#2e0a0a,stroke:#ff5a5a,color:#ff8a8a,stroke-width:2px',
    ],
    light: [
      'classDef muted fill:#e8edf4,stroke:#c2cfe0,color:#6b7c93,stroke-width:1px',
      'classDef logic fill:#e6f5ec,stroke:#16a34a,color:#15803d,stroke-width:2px',
      'classDef llm fill:#e8efff,stroke:#3f79ff,color:#2c5cd1,stroke-width:2px',
      'classDef accent fill:#e6f5ec,stroke:#16a34a,color:#15803d,stroke-width:2px',
      'classDef danger fill:#fef2f2,stroke:#ef4444,color:#dc2626,stroke-width:2px',
    ],
  };

  function isLight(): boolean {
    const explicit = document.documentElement.getAttribute('data-theme');
    if (explicit) return explicit === 'light';
    return window.matchMedia('(prefers-color-scheme: light)').matches;
  }

  function getThemeVars() {
    return isLight() ? lightVars : darkVars;
  }

  function themeSource(source: string): string {
    // Strip any existing classDef lines from the post source
    const stripped = source.replace(/^\s*classDef\s+.+$/gm, '').trimEnd();
    const defs = isLight() ? classDefs.light : classDefs.dark;
    return stripped + '\n' + defs.join('\n');
  }

  function show() {
    document.querySelectorAll<HTMLElement>('.mermaid-wrapper').forEach(el => {
      el.style.opacity = '1';
    });
  }

  function roundNodes() {
    document.querySelectorAll<SVGRectElement>('.mermaid .node rect').forEach(rect => {
      rect.setAttribute('rx', '14');
      rect.setAttribute('ry', '14');
    });
  }

  const flowchartOpts = { curve: 'basis', padding: 18, nodeSpacing: 40, rankSpacing: 55, wrappingWidth: 160, useMaxWidth: true } as const;

  function addZoomControls() {
    document.querySelectorAll<HTMLElement>('.mermaid-wrapper').forEach(wrapper => {
      const svg = wrapper.querySelector<SVGElement>('svg');
      if (!svg) return;

      const initial = 0.85;
      let scale = initial;
      const max = 3;

      // Center the scaled SVG within the wrapper
      const ww = wrapper.clientWidth;
      const sh = svg.getBoundingClientRect().height;
      let tx = ww * (1 - initial) / 2;
      let ty = sh * (1 - initial) / 2;

      function apply() {
        svg.style.transform = `translate(${tx}px, ${ty}px) scale(${scale})`;
        svg.style.transformOrigin = '0 0';
        wrapper.style.cursor = scale > initial ? 'grab' : '';
      }

      apply();

      function resetToCenter() {
        tx = ww * (1 - initial) / 2;
        ty = sh * (1 - initial) / 2;
      }

      // Pinch / ctrl+wheel to zoom
      wrapper.addEventListener('wheel', (e: WheelEvent) => {
        if (!e.ctrlKey && !e.metaKey) return;
        e.preventDefault();
        const rect = wrapper.getBoundingClientRect();
        const mx = e.clientX - rect.left;
        const my = e.clientY - rect.top;
        const prev = scale;
        scale = Math.min(max, Math.max(initial, scale * (1 - e.deltaY * 0.01)));
        if (scale <= initial) {
          resetToCenter();
        } else {
          const ratio = scale / prev;
          tx = mx - ratio * (mx - tx);
          ty = my - ratio * (my - ty);
        }
        apply();
      }, { passive: false });

      // Click-drag / touch-drag to pan
      let dragging = false, startX = 0, startY = 0, startTx = 0, startTy = 0;

      wrapper.addEventListener('pointerdown', (e: PointerEvent) => {
        if (scale <= initial) return;
        dragging = true;
        startX = e.clientX; startY = e.clientY;
        startTx = tx; startTy = ty;
        wrapper.setPointerCapture(e.pointerId);
        wrapper.style.cursor = 'grabbing';
      });

      wrapper.addEventListener('pointermove', (e: PointerEvent) => {
        if (!dragging) return;
        tx = startTx + (e.clientX - startX);
        ty = startTy + (e.clientY - startY);
        apply();
      });

      wrapper.addEventListener('pointerup', () => {
        dragging = false;
        wrapper.style.cursor = scale > initial ? 'grab' : '';
      });

      // Double-click to reset
      wrapper.addEventListener('dblclick', () => {
        scale = initial;
        resetToCenter();
        apply();
      });

      // Touch pinch to zoom
      let lastDist = 0;
      wrapper.addEventListener('touchstart', (e: TouchEvent) => {
        if (e.touches.length === 2) {
          const dx = e.touches[0].clientX - e.touches[1].clientX;
          const dy = e.touches[0].clientY - e.touches[1].clientY;
          lastDist = Math.hypot(dx, dy);
        }
      }, { passive: true });

      wrapper.addEventListener('touchmove', (e: TouchEvent) => {
        if (e.touches.length === 2) {
          e.preventDefault();
          const dx = e.touches[0].clientX - e.touches[1].clientX;
          const dy = e.touches[0].clientY - e.touches[1].clientY;
          const dist = Math.hypot(dx, dy);
          const prev = scale;
          scale = Math.min(max, Math.max(initial, scale * (dist / lastDist)));
          if (scale <= initial) {
            resetToCenter();
            lastDist = dist;
            apply();
            return;
          }
          const rect = wrapper.getBoundingClientRect();
          const mx = (e.touches[0].clientX + e.touches[1].clientX) / 2 - rect.left;
          const my = (e.touches[0].clientY + e.touches[1].clientY) / 2 - rect.top;
          const ratio = scale / prev;
          tx = mx - ratio * (mx - tx);
          ty = my - ratio * (my - ty);
          lastDist = dist;
          apply();
        }
      }, { passive: false });
    });
  }

  async function initMermaid() {
    try {
      const { default: mermaid } = await import('https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs');

      mermaid.initialize({
        startOnLoad: false,
        theme: 'base',
        themeVariables: getThemeVars(),
        flowchart: flowchartOpts,
      });

      // Read chart source from <script type="application/mermaid"> siblings.
      // We avoid set:text on the <pre> because Mermaid v11 reads innerHTML
      // and runs entityDecode via a temp <div>, which corrupts <br/> tags
      // and can collapse whitespace in subgraph blocks.
      document.querySelectorAll<HTMLElement>('.mermaid-wrapper').forEach(wrapper => {
        const chart = wrapper.getAttribute('data-chart') || '';
        const pre = wrapper.querySelector('.mermaid');
        if (pre) {
          pre.setAttribute('data-mermaid-source', chart.trim());
        }
      });

      function applyThemeClasses() {
        document.querySelectorAll<HTMLElement>('.mermaid').forEach(el => {
          const source = el.getAttribute('data-mermaid-source') || '';
          el.textContent = themeSource(source);
        });
      }

      applyThemeClasses();
      await mermaid.run({ querySelector: '.mermaid' });
      roundNodes();
      addZoomControls();
      show();

      // Re-render on theme toggle
      const toggle = document.getElementById('theme-toggle');
      toggle?.addEventListener('click', async () => {
        await new Promise(r => setTimeout(r, 50));

        document.querySelectorAll<HTMLElement>('.mermaid').forEach(el => {
          el.removeAttribute('data-processed');
          el.innerHTML = '';
        });

        applyThemeClasses();

        mermaid.initialize({
          startOnLoad: false,
          theme: 'base',
          themeVariables: getThemeVars(),
          flowchart: flowchartOpts,
        });

        await mermaid.run({ querySelector: '.mermaid' });
        roundNodes();
        addZoomControls();
      });
    } catch (e) {
      console.error('Mermaid init failed:', e);
      show();
    }
  }

  initMermaid();
</script>

<style>
  /* ── Wrapper ── */
  .mermaid-wrapper {
    position: relative;
    border: 1px solid var(--line);
    border-radius: 1.25rem;
    padding: 0;
    margin: 2rem -2rem;
    opacity: 0;
    transition: opacity 0.4s ease;
    overflow: hidden;
    background: rgba(0, 0, 0, 0.02);
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.04);
  }

  @media (max-width: 640px) {
    .mermaid-wrapper {
      margin-inline: -0.5rem;
      padding: 0;
      border-radius: 0.75rem;
    }
  }

  @media (min-width: 1200px) {
    .mermaid-wrapper {
      margin-inline: 0;
    }
  }

  /* Dark wrapper — glass card style */
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme]) .mermaid-wrapper {
      background: linear-gradient(145deg, rgba(20, 29, 44, 0.84), rgba(9, 14, 23, 0.62));
      border-color: rgba(212, 230, 255, 0.12);
      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.06),
        0 8px 32px -12px rgba(0, 0, 0, 0.6);
      backdrop-filter: blur(12px) saturate(130%);
      -webkit-backdrop-filter: blur(12px) saturate(130%);
    }
  }
  [data-theme="dark"] .mermaid-wrapper {
    background: linear-gradient(145deg, rgba(20, 29, 44, 0.84), rgba(9, 14, 23, 0.62));
    border-color: rgba(212, 230, 255, 0.12);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.06),
      0 8px 32px -12px rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(12px) saturate(130%);
    -webkit-backdrop-filter: blur(12px) saturate(130%);
  }

  /* ── Pre reset ── */
  .mermaid {
    display: flex;
    justify-content: center;
    background: none !important;
    border: none !important;
    padding: 0 !important;
    margin: 0 !important;
  }
  .mermaid svg {
    width: 100%;
    height: auto;
  }

  /* ═══════════════════════════════════════════════
     SVG node styling — applied after Mermaid render
     ═══════════════════════════════════════════════ */

  /* ── All nodes: subtle shadow ── */
  .mermaid :global(.node rect),
  .mermaid :global(.node circle),
  .mermaid :global(.node polygon) {
    filter: drop-shadow(0 2px 6px rgba(0, 0, 0, 0.25));
    transition: filter 0.2s ease;
  }

  /* ── .logic nodes: green glow ── */
  .mermaid :global(.node.logic rect),
  .mermaid :global(.node.logic circle),
  .mermaid :global(.node.logic polygon) {
    filter: drop-shadow(0 0 12px rgba(30, 215, 96, 0.35))
            drop-shadow(0 2px 8px rgba(0, 0, 0, 0.3));
  }

  /* ── .llm nodes: blue glow ── */
  .mermaid :global(.node.llm rect),
  .mermaid :global(.node.llm circle),
  .mermaid :global(.node.llm polygon) {
    filter: drop-shadow(0 0 12px rgba(63, 121, 255, 0.35))
            drop-shadow(0 2px 8px rgba(0, 0, 0, 0.3));
  }

  /* ── .accent nodes: accent glow ── */
  .mermaid :global(.node.accent rect),
  .mermaid :global(.node.accent circle),
  .mermaid :global(.node.accent polygon) {
    filter: drop-shadow(0 0 12px rgba(30, 215, 96, 0.4))
            drop-shadow(0 2px 8px rgba(0, 0, 0, 0.3));
  }

  /* ── .danger nodes: red glow ── */
  .mermaid :global(.node.danger rect),
  .mermaid :global(.node.danger circle),
  .mermaid :global(.node.danger polygon) {
    filter: drop-shadow(0 0 12px rgba(255, 90, 90, 0.35))
            drop-shadow(0 2px 8px rgba(0, 0, 0, 0.3));
  }

  /* ── Edge lines ── */
  .mermaid :global(.edge-pattern-solid) {
    stroke-opacity: 0.6;
  }

  /* ── Edge labels ── */
  .mermaid :global(.edgeLabel) {
    font-size: 0.8rem;
  }
  .mermaid :global(.edgeLabel rect) {
    filter: none;
    opacity: 0.85;
  }

  /* ── Cluster / subgraph labels ── */
  .mermaid :global(.cluster-label) {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  /* ── Light mode overrides ── */
  @media (prefers-color-scheme: light) {
    :root:not([data-theme]) .mermaid :global(.node rect),
    :root:not([data-theme]) .mermaid :global(.node circle),
    :root:not([data-theme]) .mermaid :global(.node polygon) {
      filter: drop-shadow(0 1px 4px rgba(0, 0, 0, 0.08));
    }
    :root:not([data-theme]) .mermaid :global(.node.logic rect) {
      filter: drop-shadow(0 0 8px rgba(22, 163, 74, 0.2))
              drop-shadow(0 1px 4px rgba(0, 0, 0, 0.08));
    }
    :root:not([data-theme]) .mermaid :global(.node.llm rect) {
      filter: drop-shadow(0 0 8px rgba(63, 121, 255, 0.2))
              drop-shadow(0 1px 4px rgba(0, 0, 0, 0.08));
    }
  }
  [data-theme="light"] .mermaid :global(.node rect),
  [data-theme="light"] .mermaid :global(.node circle),
  [data-theme="light"] .mermaid :global(.node polygon) {
    filter: drop-shadow(0 1px 4px rgba(0, 0, 0, 0.08));
  }
  [data-theme="light"] .mermaid :global(.node.logic rect) {
    filter: drop-shadow(0 0 8px rgba(22, 163, 74, 0.2))
            drop-shadow(0 1px 4px rgba(0, 0, 0, 0.08));
  }
  [data-theme="light"] .mermaid :global(.node.llm rect) {
    filter: drop-shadow(0 0 8px rgba(63, 121, 255, 0.2))
            drop-shadow(0 1px 4px rgba(0, 0, 0, 0.08));
  }

</style>
