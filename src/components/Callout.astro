---
interface Props {
  label?: string;
}

const { label } = Astro.props;
---

<aside class="callout" role="note">
  {label && <p class="callout-label">{label}</p>}
  <div class="callout-body">
    <slot />
  </div>
</aside>

<style>
  .callout {
    margin: 2rem 0;
    padding: 1.25rem 0;
    border-top: 1px solid transparent;
    border-bottom: 1px solid transparent;
    border-image: linear-gradient(90deg, transparent, var(--line), transparent) 1;
  }
  .callout-label {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.92rem;
    color: var(--ink-muted);
    margin-bottom: 0.5rem;
  }
  .callout-body {
    font-size: 0.92rem;
    line-height: 1.7;
    color: var(--ink-muted);
  }
  .callout-body :global(p) {
    margin-bottom: 0.75rem;
    color: var(--ink-muted);
  }
  .callout-body :global(p:last-child) {
    margin-bottom: 0;
  }
  .callout-body :global(strong) {
    color: var(--foreground);
    font-weight: 600;
  }
  .callout-body :global(code) {
    font-family: var(--font-mono);
    font-size: 0.85em;
    padding: 0.15rem 0.4rem;
    border-radius: 0.35rem;
    background: rgba(0,0,0,0.04);
    border: 1px solid var(--line);
    color: var(--foreground);
  }
</style>
