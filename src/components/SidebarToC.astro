---
interface Props {
  headings: { depth: number; slug: string; text: string }[];
  seriesLabel?: string;
  seriesTitle?: string;
}

const { headings, seriesLabel, seriesTitle } = Astro.props;

const h2Headings = headings.filter(h => h.depth === 2);
if (h2Headings.length < 3) return null;

const tocHeadings = headings.filter(h => h.depth === 2 || h.depth === 3);

// Subsections sit under their section, and open only while you're reading that section
const sections: { h: (typeof tocHeadings)[number]; kids: typeof tocHeadings }[] = [];
for (const h of tocHeadings) {
  if (h.depth === 2 || !sections.length) sections.push({ h, kids: [] });
  else sections[sections.length - 1].kids.push(h);
}
---

{h2Headings.length >= 3 && (
  <nav class="sidebar-toc" aria-label="Table of contents">
    {seriesLabel && (
      <a href="#series-nav-anchor" class="sidebar-series-badge mono">
        <span class="sidebar-series-dot"></span>
        <span class="sidebar-series-text">
          <span>{seriesLabel}</span>
          {seriesTitle && <em class="sidebar-series-title">{seriesTitle}</em>}
        </span>
      </a>
    )}
    <p class="sidebar-toc-title">Contents</p>
    <ol class="sidebar-toc-list">
      {sections.map(({ h, kids }) => (
        <li class="sidebar-toc-item sidebar-toc-depth-2" data-section={h.slug}>
          <a href={`#${h.slug}`} data-heading={h.slug} data-section={h.slug}>{h.text}</a>
          {kids.length > 0 && (
            <div class="sidebar-toc-sub">
              <ol>
                {kids.map(k => (
                  <li class="sidebar-toc-item sidebar-toc-depth-3">
                    <a href={`#${k.slug}`} data-heading={k.slug} data-section={h.slug} tabindex="-1">{k.text}</a>
                  </li>
                ))}
              </ol>
            </div>
          )}
        </li>
      ))}
    </ol>
  </nav>
)}

<style>
  .sidebar-toc {
    display: none;
  }

  @media (min-width: 1200px) {
    .sidebar-toc {
      display: block;
      max-height: calc(100vh - 4rem);
      overflow-y: auto;
      padding-top: 0.05rem;
      padding-left: 1.25rem;
      border-left: 1px solid transparent;
      border-image: linear-gradient(180deg, var(--line) 0%, transparent 100%) 1;
    }

    .sidebar-series-badge {
      display: flex;
      align-items: flex-start;
      gap: 0.45rem;
      font-size: 0.72rem;
      color: var(--accent);
      text-decoration: none;
      margin-bottom: 0.85rem;
      padding-bottom: 0.75rem;
      border-bottom: 1px solid var(--line);
      transition: color 0.2s ease-out;
    }
    .sidebar-series-badge:hover {
      color: var(--foreground);
      text-decoration: none;
    }
    .sidebar-series-dot {
      width: 0.4rem;
      height: 0.4rem;
      border-radius: 50%;
      background: var(--accent);
      flex-shrink: 0;
      margin-top: 0.35rem;
    }
    .sidebar-series-text {
      display: flex;
      flex-direction: column;
      gap: 0.15rem;
    }
    .sidebar-series-text > span {
      white-space: nowrap;
    }
    .sidebar-series-title {
      font-family: var(--font-serif);
      font-style: italic;
      color: var(--ink-muted);
      font-size: 0.68rem;
    }

    .sidebar-toc-title {
      font-size: 0.75rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--ink-muted);
      margin-bottom: 0.75rem;
    }

    .sidebar-toc ol {
      list-style: none;
      padding: 0;
      margin: 0;
      counter-reset: none;
    }

    .sidebar-toc ol > li::before {
      content: none;
    }

    .sidebar-toc-item {
      margin-bottom: 0.2rem;
    }

    .sidebar-toc-item a {
      display: block;
      color: var(--ink-muted);
      text-decoration: none;
      font-size: 0.8rem;
      line-height: 1.5;
      padding: 0.15rem 0 0.15rem 0.75rem;
      border-left: 2px solid transparent;
      transition: color 0.2s ease-out, border-color 0.2s ease-out;
    }

    .sidebar-toc-item a:hover {
      color: var(--foreground);
      text-decoration: none;
    }

    .sidebar-toc-item a.active {
      color: var(--accent);
    }

    /* Sections you've read settle back; the one you're in stays bright */
    .sidebar-toc-depth-2.read > a {
      color: color-mix(in srgb, var(--ink-muted) 62%, transparent);
    }
    .sidebar-toc-depth-2.open > a:not(.active) {
      color: var(--foreground);
    }

    /* Subsections fold away until their section is open */
    .sidebar-toc-sub {
      display: grid;
      grid-template-rows: 0fr;
      transition: grid-template-rows 0.35s cubic-bezier(0.3, 0.7, 0.2, 1);
    }
    .sidebar-toc-sub > ol {
      overflow: hidden;
      min-height: 0;
    }
    .open > .sidebar-toc-sub {
      grid-template-rows: 1fr;
    }

    .sidebar-toc-depth-3 {
      margin-left: 0.75rem;
    }

    .sidebar-toc-depth-3 a {
      font-size: 0.75rem;
    }

    /* How far through the article you are, drawn down the rail's edge */
    .sidebar-toc-list {
      position: relative;
    }
    .sidebar-toc-list::before {
      content: "";
      position: absolute;
      left: -1.25rem;
      top: 0;
      width: 2px;
      margin-left: -1px;
      height: calc(var(--read, 0) * 100%);
      background: linear-gradient(180deg, color-mix(in srgb, var(--accent) 30%, transparent), var(--accent));
      border-radius: 2px;
      transition: height 0.12s linear;
    }
  }

  @media (min-width: 1200px) and (prefers-reduced-motion: reduce) {
    .sidebar-toc-sub, .sidebar-toc-list::before { transition: none; }
  }
</style>

<script>
  function initSidebarToc() {
    const links = [...document.querySelectorAll<HTMLAnchorElement>('.sidebar-toc-item a[data-heading]')];
    const list = document.querySelector<HTMLElement>('.sidebar-toc-list');
    const prose = document.querySelector<HTMLElement>('.prose');
    if (!links.length || !list || !prose) return;

    const sections = [...document.querySelectorAll<HTMLElement>('.sidebar-toc-depth-2[data-section]')];
    const targets = links
      .map(link => ({ link, heading: document.getElementById(link.dataset.heading ?? '') }))
      .filter((t): t is { link: HTMLAnchorElement; heading: HTMLElement } => t.heading !== null);

    // Worked out from the scroll position each frame, so a jump to a section is right straight away
    let current: HTMLAnchorElement | null = null;
    let queued = false;
    const update = () => {
      queued = false;
      const line = window.innerHeight * 0.3;
      let here: HTMLAnchorElement | null = null;
      for (const t of targets) {
        if (t.heading.getBoundingClientRect().top <= line) here = t.link;
        else break;
      }
      if (here !== current) {
        current?.classList.remove('active');
        here?.classList.add('active');
        current = here;
        // Open the section you're in, and settle the ones before it
        const section = here?.dataset.section;
        let before = Boolean(section);
        for (const li of sections) {
          const open = li.dataset.section === section;
          if (open) before = false;
          li.classList.toggle('open', open);
          li.classList.toggle('read', before);
          li.querySelectorAll<HTMLElement>('.sidebar-toc-depth-3 a').forEach(a => { a.tabIndex = open ? 0 : -1; });
        }
      }
      // The rail: how far through the article's text you've scrolled
      const r = prose.getBoundingClientRect();
      const read = Math.min(1, Math.max(0, (line - r.top) / Math.max(1, r.height - window.innerHeight * 0.5)));
      list.style.setProperty('--read', read.toFixed(4));
    };
    const onScroll = () => { if (!queued) { queued = true; requestAnimationFrame(update); } };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    update();
  }

  initSidebarToc();
  document.addEventListener('astro:after-swap', initSidebarToc);
</script>
