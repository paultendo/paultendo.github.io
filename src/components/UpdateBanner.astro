---
interface Props {
  mode: "updated" | "snapshot";
  date: string;
  updateNote?: string;
  linkTo: string;
}

const { mode, date, updateNote, linkTo } = Astro.props;

const formattedDate = new Date(date).toLocaleDateString("en-GB", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<aside class="update-banner" role="note">
  {mode === "updated" ? (
    <p>
      <strong>Updated {formattedDate}:</strong>{" "}
      {updateNote}{" "}
      <a href={linkTo}>Read the original version &rarr;</a>
    </p>
  ) : (
    <p>
      You're reading an archived version of this post from {formattedDate}.{" "}
      <a href={linkTo}>Read the current version &rarr;</a>
    </p>
  )}
</aside>

<style>
  .update-banner {
    max-width: 68ch;
    margin-inline: auto;
    margin-bottom: 1.5rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--line);
    border-radius: 0.5rem;
    font-size: 0.88rem;
    line-height: 1.5;
    color: var(--ink-muted);
  }
  .update-banner p {
    margin: 0;
  }
  .update-banner a {
    color: var(--accent);
    text-decoration: none;
  }
  .update-banner a:hover {
    text-decoration: underline;
  }
</style>
