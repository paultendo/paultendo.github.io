---
// Each tool's picture: a screenshot, a specimen, or real code. Shared by the homepage and the Tools page.
interface Props {
  id: "tothepenny" | "namespace-guard" | "confusable-vision" | "d0ma1n";
}
const { id } = Astro.props;
---

<div class:list={["tv", `tv--${id}`]} aria-hidden="true">
  {id === "tothepenny" && (
    <>
      <img class="tv-shot tv-shot--light" src="/images/tothepenny/results-light.png" alt="" loading="lazy" />
      <img class="tv-shot tv-shot--dark" src="/images/tothepenny/results-dark.png" alt="" loading="lazy" />
    </>
  )}

  {id === "confusable-vision" && (
    <img class="tv-plate" src="/images/confusable-vision/rayspace-hero.png" alt="" loading="lazy" />
  )}

  {id === "namespace-guard" && (
    <pre class="tv-code"><code><span class="k">import</span> {"{"} areConfusable {"}"} <span class="k">from</span> <span class="s">"namespace-guard"</span>;
<span class="k">import</span> {"{"} CONFUSABLE_WEIGHTS {"}"}
  <span class="k">from</span> <span class="s">"namespace-guard/confusable-weights"</span>;

<span class="c">// Cyrillic І and Greek Ι are identical outlines (62 fonts)</span>
<span class="f">areConfusable</span>(<span class="s">"І"</span>, <span class="s">"Ι"</span>, {"{"}
  weights: CONFUSABLE_WEIGHTS,
{"}"}); <span class="c">// true</span>

<span class="c">// users, organisations and reserved routes, in one call</span>
<span class="k">await</span> guard.<span class="f">assertClaimable</span>(<span class="s">"acme-corp"</span>);</code></pre>
  )}

  {id === "d0ma1n" && (
    <div class="tv-specimen">
      <p class="tv-domain">scope.com</p>
      <p class="tv-domain"><span>sc<mark>0</mark>pe.com</span><span class="tv-note mono">zero for o</span></p>
      <p class="tv-domain"><span><mark>ѕсоре</mark>.com</span><span class="tv-note mono">all Cyrillic</span></p>
      <p class="tv-domain tv-domain--refused"><span>scop<mark>е</mark>.com</span><span class="tv-note mono">mixed script, refused</span></p>
    </div>
  )}
</div>

<style>
  .tv {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: 12px;
  }
  .tv-shot {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top left;
    border-radius: 12px;
    border: 1px solid var(--line);
    box-shadow: 0 18px 50px -24px rgba(0, 0, 0, 0.45);
  }
  .tv-shot--dark {
    display: none;
  }
  :global([data-theme="dark"]) .tv-shot--light {
    display: none;
  }
  :global([data-theme="dark"]) .tv-shot--dark {
    display: block;
  }
  .tv--confusable-vision {
    background: #fbfbf9;
    border: 1px solid var(--line);
  }
  .tv-plate {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
    mix-blend-mode: multiply;
  }
  .tv-code {
    margin: 0;
    height: 100%;
    display: flex;
    align-items: center;
    padding: 1.1rem 1.2rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    line-height: 1.7;
    white-space: pre;
    overflow: hidden;
    color: var(--foreground);
    background: color-mix(in srgb, var(--foreground) 4%, transparent);
    border: 1px solid var(--line);
    border-radius: 12px;
  }
  @media (max-width: 520px) {
    .tv-code {
      font-size: 0.58rem;
      padding: 0.85rem 0.9rem;
    }
  }
  .tv-code .k { color: #c792ea; }
  .tv-code .s { color: var(--accent); }
  .tv-code .f { color: #82aaff; }
  .tv-code .c { color: var(--ink-muted); font-style: italic; }
  .tv-specimen {
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.35rem;
    padding: 1rem 1.2rem;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: color-mix(in srgb, var(--foreground) 3%, transparent);
  }
  .tv-domain {
    margin: 0;
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
    font-family: var(--font-serif);
    font-size: clamp(1.1rem, 1.9vw, 1.45rem);
    letter-spacing: -0.01em;
    color: var(--foreground);
  }
  .tv-domain:first-child {
    color: var(--ink-muted);
  }
  .tv-domain mark {
    background: none;
    color: var(--red);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }
  .tv-domain:first-child mark {
    color: inherit;
    text-decoration: none;
  }
  .tv-domain--refused > span:first-child {
    color: var(--ink-muted);
    text-decoration: line-through;
    text-decoration-thickness: 1.5px;
  }
  .tv-domain--refused mark {
    color: inherit;
    text-decoration: none;
  }
  .tv-note {
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }
</style>
