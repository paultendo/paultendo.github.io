---
import Base from "../layouts/Base.astro";
import "../styles/global.css";
import { TOOLS } from "../data/tools";
import ToolVisual from "../components/ToolVisual.astro";

const external = (href: string) => href.startsWith("http");
---

<Base
  title="Tools · paultendo"
  description="Open-source tools by Paul Wood FRSA for bank statements, Unicode security, namespace validation and brand protection. Free to use and built in public."
>
  <div class="shell tools-v2">
    <section class="tools-hero">
      <p class="tools-kicker mono">Tools</p>
      <h1 class="tools-line">Free to use, and built in public.</h1>
      <p class="tools-lede">
        Four open-source tools. One checks bank statements against the bank's own balances; three come out of research
        into characters that pass for one another.
      </p>
    </section>

    <div class="tools-rows">
      {TOOLS.map((tool, index) => (
        <article class:list={["tool-row", { "tool-row--flip": index % 2 === 1 }]}>
          <a class="tool-row-visual" href={tool.primary.href} target={external(tool.primary.href) ? "_blank" : undefined} rel={external(tool.primary.href) ? "noopener" : undefined} tabindex="-1" aria-hidden="true">
            <ToolVisual id={tool.id} />
          </a>
          <div class="tool-row-copy">
            <div class="tool-row-head">
              <h2 class="tool-row-name display-type">{tool.name}</h2>
              <span class:list={["tool-row-badge", "mono", { "tool-row-badge--live": tool.live }]}>{tool.badge}</span>
            </div>
            <p class="tool-row-tagline">{tool.tagline}</p>
            <p class="tool-row-desc">{tool.description}</p>
            <dl class="tool-row-stats">
              {tool.stats.map(([value, label]) => (
                <div>
                  <dt class="mono">{label}</dt>
                  <dd class="display-type">{value}</dd>
                </div>
              ))}
            </dl>
            <div class="tool-row-links">
              <a class="tool-row-go" href={tool.primary.href} target={external(tool.primary.href) ? "_blank" : undefined} rel={external(tool.primary.href) ? "noopener" : undefined}>{tool.primary.label} <span aria-hidden="true">&rarr;</span></a>
              {tool.links.map((link) => (
                <a class="tool-row-link mono" href={link.href} target={external(link.href) ? "_blank" : undefined} rel={external(link.href) ? "noopener" : undefined}>{link.label}</a>
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>

    <section class="tools-connect" aria-label="How they connect">
      <p class="tools-kicker mono">How they connect</p>
      <div class="tools-chain">
        <span class="chain-node">confusable-vision</span>
        <span class="chain-edge mono">scored pairs</span>
        <span class="chain-node">namespace-guard</span>
        <span class="chain-edge mono">matching</span>
        <span class="chain-node">d0ma1n</span>
      </div>
      <p class="tools-connect-copy">
        confusable-vision measures which characters look alike. namespace-guard ships those measurements as its
        confusable maps, and d0ma1n uses namespace-guard to find lookalike domains. The
        <a href="/#writing">research posts</a> tell the story in order.
      </p>
    </section>
  </div>
</Base>

<style>
  .tools-v2 {
    max-width: var(--layout-frame-width);
    margin-inline: auto;
    padding-bottom: 6rem;
  }
  .tools-hero {
    padding: clamp(3rem, 9vh, 6rem) 0 clamp(2.5rem, 6vh, 4rem);
    max-width: 44rem;
  }
  .tools-kicker {
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    color: var(--ink-muted);
    margin: 0 0 1rem;
  }
  .tools-line {
    font-family: var(--font-serif);
    font-optical-sizing: auto;
    font-weight: 400;
    font-size: clamp(2.3rem, 5.2vw, 4rem);
    line-height: 1.02;
    letter-spacing: -0.035em;
    margin: 0 0 1.2rem;
    text-wrap: balance;
  }
  .tools-lede {
    font-size: clamp(1rem, 1.35vw, 1.12rem);
    line-height: 1.65;
    color: var(--ink-muted);
    margin: 0;
    text-wrap: pretty;
  }

  .tools-rows {
    display: flex;
    flex-direction: column;
    gap: clamp(3.5rem, 9vh, 6rem);
  }
  .tool-row {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: clamp(1.75rem, 4vw, 3.5rem);
    align-items: center;
  }
  .tool-row--flip .tool-row-visual {
    order: 2;
  }
  .tool-row-visual {
    display: block;
    height: clamp(15rem, 30vw, 22rem);
    border-radius: 14px;
    transition: transform 0.25s ease-out;
  }
  .tool-row-visual:hover {
    transform: translateY(-3px);
  }
  .tool-row-head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
  }
  .tool-row-name {
    font-size: clamp(1.45rem, 2.4vw, 1.9rem);
    font-weight: 700;
    line-height: 1.1;
    margin: 0;
    white-space: nowrap;
  }
  .tool-row-badge {
    flex: none;
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.18rem 0.55rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    color: var(--ink-muted);
    white-space: nowrap;
  }
  .tool-row-badge--live {
    color: var(--accent);
    border-color: color-mix(in srgb, var(--accent) 40%, transparent);
    background: color-mix(in srgb, var(--accent) 8%, transparent);
  }
  .tool-row-tagline {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(1.1rem, 1.6vw, 1.3rem);
    color: var(--foreground);
    margin: 0 0 0.8rem;
  }
  .tool-row-desc {
    color: var(--ink-muted);
    line-height: 1.65;
    margin: 0 0 1.4rem;
    text-wrap: pretty;
  }
  .tool-row-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0 0 1.5rem;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .tool-row-stats div {
    padding: 0.85rem 0.9rem 0.8rem 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .tool-row-stats div + div {
    padding-left: 0.9rem;
    border-left: 1px solid var(--line);
  }
  .tool-row-stats dt {
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin-bottom: 0.3rem;
    line-height: 1.35;
  }
  .tool-row-stats dd {
    margin: 0;
    font-size: 1.35rem;
    font-weight: 700;
    line-height: 1;
    color: var(--foreground);
  }
  .tool-row-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 1.2rem;
  }
  .tool-row-go {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    height: 2.35rem;
    padding: 0 1rem;
    border-radius: 999px;
    background: var(--foreground);
    color: var(--background);
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    transition: transform 0.15s ease-out, background 0.15s ease-out;
  }
  .tool-row-go:hover {
    background: var(--accent);
    color: var(--background);
    transform: translateY(-1px);
  }
  .tool-row-link {
    font-size: 0.74rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-muted);
    text-decoration: none;
  }
  .tool-row-link:hover {
    color: var(--accent);
  }

  .tools-connect {
    margin-top: clamp(4rem, 10vh, 7rem);
    padding-top: 2.25rem;
    border-top: 1px solid var(--line);
    max-width: 48rem;
  }
  .tools-chain {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 1.1rem;
  }
  .chain-node {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.95rem;
    padding: 0.4rem 0.8rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--foreground) 3%, transparent);
  }
  .chain-edge {
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  .chain-edge::after {
    content: " \2192";
    color: var(--accent);
  }
  .tools-connect-copy {
    color: var(--ink-muted);
    line-height: 1.65;
    margin: 0;
  }
  .tools-connect-copy a {
    color: var(--accent);
  }

  @media (max-width: 820px) {
    .tool-row {
      grid-template-columns: 1fr;
    }
    .tool-row--flip .tool-row-visual {
      order: 0;
    }
    .tool-row-visual {
      height: 15rem;
    }
  }
</style>
