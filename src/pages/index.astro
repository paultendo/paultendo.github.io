---
import Base from "../layouts/Base.astro";
import "../styles/global.css";
import { getCollection } from "astro:content";
import { getReadingTime, formatReadingTime } from "../utils/readingTime";
import { isPublishedPrimaryPost } from "../utils/postFilters";
import { SERIES } from "../utils/seriesData";
import { sortPosts } from "../utils/sortPosts";

const now = new Date();
const posts = sortPosts(
  (await getCollection("posts")).filter((p) => isPublishedPrimaryPost(p, now))
);
const unicodeSeries = SERIES.find((series) => series.id === "unicode-identifier-security");

function getEditorialTopics(post: (typeof posts)[number]): string[] {
  const tags = post.data.tags || [];
  const topics = new Set<string>();

  if (
    unicodeSeries?.posts.includes(post.id) ||
    tags.some((tag) => ["unicode", "security", "fonts", "identity"].includes(tag))
  ) {
    topics.add("unicode-security");
  }

  if (
    tags.some((tag) =>
      ["open-source", "npm", "typescript", "browser-extensions", "namespace-guard", "performance", "oncor"].includes(tag)
    )
  ) {
    topics.add("tools-and-infra");
  }

  if (
    tags.some((tag) =>
      ["ai", "legal-tech", "architecture", "opinion", "ai-music", "llm"].includes(tag)
    )
  ) {
    topics.add("applied-ai");
  }

  if (topics.size === 0) topics.add("notes");
  return [...topics];
}

const leadPost = posts.find((post) => post.data.featured) ?? posts[0];
const remainingPosts = posts.filter((post) => post.id !== leadPost.id);
const domainAnchorPost = posts.find((post) => post.id === "idn-relevance");
const unicodeProgrammeCount =
  unicodeSeries?.posts.filter((id) => posts.some((post) => post.id === id)).length ?? 0;
const editorialSections = [
  {
    key: "unicode-security",
    label: "Unicode security",
    description: "The main research programme.",
    count: posts.filter((post) => getEditorialTopics(post).includes("unicode-security")).length,
  },
  {
    key: "tools-and-infra",
    label: "Tools and infrastructure",
    description: "Libraries, performance and systems work.",
    count: posts.filter((post) => getEditorialTopics(post).includes("tools-and-infra")).length,
  },
  {
    key: "applied-ai",
    label: "Applied AI systems",
    description: "Legal and product architecture.",
    count: posts.filter((post) => getEditorialTopics(post).includes("applied-ai")).length,
  },
];
---

<Base
  title="paultendo"
  description="Research notes by Paul Wood FRSA on Unicode security, open-source tools and applied AI systems."
>
  <div class="shell home-frame">
    <section class="top-composition">
      <section class="hero">
        <h1 class="display-type">paultendo</h1>
        <p class="hero-tagline">Researching Unicode security, shipping open-source tools, building applied AI systems.</p>
        <p class="hero-intro">
          Mostly writing about identifier spoofing, confusable detection and systems designed for measurable behaviour.
        </p>
      </section>

      <section class="programme-strip glass-card" aria-label="Programme and links">
        <div class="programme-block programme-block--primary">
          <p class="programme-label mono">Current programme</p>
          <h2 class="programme-title display-type">Unicode identifier security</h2>
          <p class="programme-copy">Cross-script spoofing, confusable detection and measurement.</p>
          <a href="#unicode-security" class="programme-link mono">Browse {unicodeProgrammeCount} posts</a>
        </div>
        <div class="programme-block">
          <p class="programme-label mono">Projects</p>
          <div class="programme-links mono">
            <a href="https://github.com/paultendo/confusable-vision" target="_blank" rel="noopener">confusable-vision</a>
            <a href="https://github.com/paultendo/namespace-guard" target="_blank" rel="noopener">namespace-guard</a>
            <a href="https://github.com/paultendo/d0ma1n" target="_blank" rel="noopener">d0ma1n</a>
          </div>
        </div>
        <div class="programme-block">
          <p class="programme-label mono">Elsewhere</p>
          <div class="programme-links mono">
            <a href="https://github.com/paultendo" target="_blank" rel="noopener">GitHub</a>
            <a href="https://www.linkedin.com/in/p-wood/" target="_blank" rel="noopener">LinkedIn</a>
            <a href="https://fiftysixlaw.co.uk" target="_blank" rel="noopener">Fifty Six Law</a>
          </div>
        </div>
      </section>
    </section>

    {domainAnchorPost && (
      <section class="start-here-section" aria-label="Start here">
        <a href={`/posts/${domainAnchorPost.id}/`} class="start-here-card glass-card">
          <div class="start-here-meta">
            <p class="start-here-kicker mono">Start here</p>
            <p class="start-here-context mono">Unicode security / domains</p>
          </div>
          <div class="start-here-copy">
            <h2 class="start-here-title display-type">{domainAnchorPost.data.title}</h2>
            <p class="start-here-desc">{domainAnchorPost.data.deck ?? domainAnchorPost.data.description}</p>
          </div>
          <div class="start-here-aside">
            <p class="start-here-metric display-type">250K → 102</p>
            <p class="start-here-cta mono">Read the filtering piece</p>
          </div>
        </a>
      </section>
    )}

    <section class="posts-section">
      <div class="posts-heading">
        <h2 class="posts-title display-type">Latest posts</h2>
        <p class="posts-intro">Three threads running through the site: Unicode security research, open-source tooling and applied AI systems.</p>
      </div>
      <div id="posts-container" data-view="cards">
        <div class="posts-controls">
          <div class="section-filter-bar" aria-label="Editorial sections">
            <p class="filters-label mono">Browse by section</p>
            <button class="section-filter section-filter-active" data-topic="all">
              <span class="section-filter-label display-type">All posts</span>
              <span class="section-filter-meta mono">{posts.length}</span>
            </button>
            {editorialSections.map((section) => (
              <button class="section-filter" data-topic={section.key}>
                <span class="section-filter-label display-type">{section.label}</span>
                <span class="section-filter-meta mono">{section.count}</span>
              </button>
            ))}
          </div>
          <div class="posts-toolbar">
            <p class="filters-label mono">Display</p>
            <button id="view-toggle" class="view-toggle" aria-label="Toggle view mode">
              <svg class="icon-list" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="8" y1="6" x2="21" y2="6"></line>
                <line x1="8" y1="12" x2="21" y2="12"></line>
                <line x1="8" y1="18" x2="21" y2="18"></line>
                <line x1="3" y1="6" x2="3.01" y2="6"></line>
                <line x1="3" y1="12" x2="3.01" y2="12"></line>
                <line x1="3" y1="18" x2="3.01" y2="18"></line>
              </svg>
              <svg class="icon-grid" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="7" height="7"></rect>
                <rect x="14" y="3" width="7" height="7"></rect>
                <rect x="14" y="14" width="7" height="7"></rect>
                <rect x="3" y="14" width="7" height="7"></rect>
              </svg>
            </button>
          </div>
        </div>
        {leadPost && (() => {
          const formattedDate = new Date(leadPost.data.date).toLocaleDateString("en-GB", {
            year: "numeric",
            month: "short",
            day: "numeric",
          });
          const updatedDate = leadPost.data.updated
            ? new Date(leadPost.data.updated).toLocaleDateString("en-GB", {
                year: "numeric",
                month: "short",
                day: "numeric",
              })
            : null;
          const readingTime = getReadingTime(leadPost.body);
          const tags = leadPost.data.tags || [];
          const topics = getEditorialTopics(leadPost);
          return (
            <a href={`/posts/${leadPost.id}/`} class:list={["post-card", "lead-story", "glass-card", { "post-card-featured": leadPost.data.featured }]} data-topics={topics.join(",")}>
              <div class="lead-story-copy">
                <div class="post-card-meta">
                  <time datetime={leadPost.data.date} class="post-card-date mono">
                    {formattedDate}{updatedDate && ` (updated ${updatedDate})`}
                  </time>
                  <span class="post-card-reading-time mono">{formatReadingTime(readingTime)}</span>
                </div>
                <h3 class="post-card-title display-type">{leadPost.data.title}</h3>
                {leadPost.data.deck && (
                  <p class="post-card-deck">{leadPost.data.deck}</p>
                )}
                <p class="post-card-desc">{leadPost.data.description}</p>
                <p class="lead-story-cta mono">Read featured post</p>
              </div>
              {tags.length > 0 && (
                <div class="post-card-tags lead-story-tags">
                  {tags.map((tag: string) => (
                    <span class="tag mono">{tag}</span>
                  ))}
                </div>
              )}
            </a>
          );
        })()}
        <div class="posts-list">
          {remainingPosts.map((post) => {
            const formattedDate = new Date(post.data.date).toLocaleDateString("en-GB", {
              year: "numeric",
              month: "short",
              day: "numeric",
            });
            const updatedDate = post.data.updated
              ? new Date(post.data.updated).toLocaleDateString("en-GB", {
                  year: "numeric",
                  month: "short",
                  day: "numeric",
                })
              : null;
            const readingTime = getReadingTime(post.body);
            const tags = post.data.tags || [];
            const topics = getEditorialTopics(post);
            return (
              <a href={`/posts/${post.id}/`} class:list={["post-card", "glass-card", { "post-card-featured": post.data.featured }]} data-topics={topics.join(",")}>
                <div class="post-card-meta">
                  <time datetime={post.data.date} class="post-card-date mono">
                    {formattedDate}{updatedDate && ` (updated ${updatedDate})`}
                  </time>
                  <span class="post-card-reading-time mono">{formatReadingTime(readingTime)}</span>
                </div>
                <h3 class="post-card-title display-type">{post.data.title}</h3>
                {post.data.featured && post.data.deck && (
                  <p class="post-card-deck">{post.data.deck}</p>
                )}
                <p class="post-card-desc">{post.data.description}</p>
                {tags.length > 0 && (
                  <div class="post-card-tags">
                    {tags.map((tag: string) => (
                      <span class="tag mono">{tag}</span>
                    ))}
                  </div>
                )}
              </a>
            );
          })}
        </div>
      </div>
    </section>
  </div>
</Base>

<style>
  .home-frame {
    max-width: var(--layout-frame-width);
    margin-inline: auto;
  }
  .top-composition {
    padding-top: clamp(1.4rem, 4vh, 2.8rem);
    margin-bottom: 1rem;
  }
  .hero {
    max-width: var(--layout-feature-width);
    margin-bottom: 1rem;
  }
  .hero h1 {
    font-size: clamp(2.6rem, 5vw, 4.35rem);
    font-weight: 800;
    line-height: 0.95;
    margin-bottom: 1rem;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }
  .hero-tagline {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(1.05rem, 1.9vw, 1.38rem);
    color: var(--ink-muted);
    max-width: 34ch;
    text-wrap: balance;
  }
  .hero-intro {
    max-width: 52ch;
    margin-top: 0.95rem;
    color: var(--ink-muted);
    line-height: 1.65;
    text-wrap: pretty;
  }
  .programme-strip {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) repeat(2, minmax(0, 0.82fr));
    gap: 1rem;
    padding: 1rem 1.1rem;
    border-radius: 1rem;
  }
  .programme-block {
    min-width: 0;
  }
  .programme-block + .programme-block {
    padding-left: 1rem;
    border-left: 1px solid rgba(14, 30, 50, 0.08);
  }
  .programme-label {
    font-size: 0.64rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin-bottom: 0.5rem;
  }
  .programme-title {
    font-size: 1.15rem;
    line-height: 1.05;
    margin-bottom: 0.35rem;
  }
  .programme-copy {
    color: var(--ink-muted);
    font-size: 0.84rem;
    line-height: 1.5;
    margin-bottom: 0.7rem;
  }
  .programme-link {
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .programme-links {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-size: 0.78rem;
  }
  .programme-links a {
    color: var(--ink-muted);
    text-decoration: none;
    line-height: 1.4;
  }
  .programme-links a:hover {
    color: var(--accent);
  }
  .start-here-section {
    margin-bottom: 1.4rem;
  }
  .start-here-card {
    display: grid;
    grid-template-columns: minmax(9rem, 0.65fr) minmax(0, 1.8fr) minmax(10rem, 0.75fr);
    align-items: start;
    gap: 1rem 1.2rem;
    text-decoration: none;
    color: var(--foreground);
    padding: 1rem 1.15rem;
    border-color: rgba(30, 215, 96, 0.16);
  }
  .start-here-card:hover {
    border-color: rgba(30, 215, 96, 0.32);
    text-decoration: none;
  }
  .start-here-card:hover .start-here-title {
    color: var(--accent);
  }
  .start-here-meta {
    min-width: 0;
  }
  .start-here-kicker,
  .start-here-context,
  .start-here-cta {
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .start-here-kicker {
    color: var(--accent);
    margin-bottom: 0.5rem;
  }
  .start-here-context {
    color: var(--ink-muted);
  }
  .start-here-copy {
    min-width: 0;
  }
  .start-here-title {
    font-size: clamp(1.2rem, 2.1vw, 1.75rem);
    line-height: 1.08;
    margin-bottom: 0.35rem;
    text-wrap: pretty;
    color: var(--foreground);
  }
  .start-here-desc {
    color: var(--ink-muted);
    line-height: 1.55;
    max-width: 60ch;
  }
  .start-here-aside {
    min-width: 0;
    text-align: right;
    align-self: center;
  }
  .start-here-metric {
    font-size: clamp(1.2rem, 2vw, 1.8rem);
    line-height: 1;
    margin-bottom: 0.45rem;
    color: var(--accent);
  }
  .start-here-cta {
    color: var(--accent);
  }
  .posts-section {
    padding-bottom: 2rem;
  }
  .posts-heading {
    max-width: 48rem;
    margin-bottom: 0.7rem;
  }
  .posts-title {
    font-size: clamp(1.6rem, 3vw, 2.5rem);
    line-height: 1.1;
    margin-bottom: 0.35rem;
    text-wrap: balance;
  }
  .posts-intro {
    color: var(--ink-muted);
    text-wrap: pretty;
    max-width: 46rem;
  }
  .posts-controls {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem 1.5rem;
    margin-bottom: 1rem;
  }
  .section-filter-bar {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.45rem 0.5rem;
  }
  .section-filter {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    text-align: left;
    padding: 0.3rem 0.55rem 0.38rem;
    border: 1px solid rgba(14, 30, 50, 0.08);
    border-radius: 999px;
    background: transparent;
    color: inherit;
    cursor: pointer;
    transition: border-color 0.15s ease, background 0.15s ease, transform 0.15s ease;
  }
  .section-filter:hover {
    border-color: rgba(30, 215, 96, 0.26);
    background: rgba(30, 215, 96, 0.04);
  }
  .section-filter-active {
    border-color: rgba(30, 215, 96, 0.36);
    background: rgba(30, 215, 96, 0.08);
  }
  .section-filter-label {
    font-size: 0.78rem;
    line-height: 1;
  }
  .section-filter-meta {
    color: var(--accent);
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .lead-story {
    display: grid;
    grid-template-columns: minmax(0, 1.7fr) minmax(11rem, 0.7fr);
    align-items: start;
    gap: 1.2rem 1.6rem;
    margin-bottom: 1rem;
    padding: clamp(1.5rem, 2.6vw, 2.2rem);
  }
  .lead-story-copy {
    min-width: 0;
    max-width: none;
  }
  .lead-story .post-card-title {
    font-size: clamp(1.95rem, 3.5vw, 2.8rem);
    line-height: 1.05;
    max-width: none;
    text-wrap: pretty;
  }
  .lead-story .post-card-desc {
    font-size: 1rem;
  }
  .lead-story-cta {
    margin-top: 1rem;
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .lead-story-tags {
    align-self: start;
    align-content: start;
    margin-top: 2.3rem;
    max-width: none;
    max-height: none;
    overflow: visible;
  }
  .posts-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  /* Toolbar: tag bar + view toggle */
  .posts-toolbar {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.75rem 1rem;
    padding: 0;
    flex-shrink: 0;
  }
  .filters-label {
    flex-shrink: 0;
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  :global([data-theme="dark"]) .programme-strip {
    border-color: rgba(212, 230, 255, 0.16);
    background: rgba(8, 16, 28, 0.34);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.06);
  }
  :global([data-theme="dark"]) .start-here-card {
    border-color: rgba(30, 215, 96, 0.22);
    background: linear-gradient(145deg, rgba(15, 28, 26, 0.7), rgba(10, 16, 27, 0.58));
  }
  :global([data-theme="dark"]) .programme-block + .programme-block {
    border-left-color: rgba(212, 230, 255, 0.1);
  }
  :global([data-theme="dark"]) .section-filter {
    border-color: rgba(212, 230, 255, 0.14);
    background: rgba(255,255,255,0.025);
  }
  @media (max-width: 980px) {
    .hero {
      max-width: none;
    }
    .programme-strip {
      grid-template-columns: 1fr;
      gap: 0.8rem;
    }
    .start-here-card {
      grid-template-columns: 1fr;
    }
    .start-here-aside {
      text-align: left;
    }
    .programme-block + .programme-block {
      padding-left: 0;
      padding-top: 0.8rem;
      border-left: 0;
      border-top: 1px solid rgba(14, 30, 50, 0.08);
    }
    :global([data-theme="dark"]) .programme-block + .programme-block {
      border-top-color: rgba(212, 230, 255, 0.1);
    }
  }
  @media (max-width: 720px) {
    .hero,
    .posts-section,
    .programme-strip,
    .start-here-card {
      text-align: center;
    }
    .hero-tagline {
      max-width: 32ch;
    }
    .hero-intro,
    .posts-intro {
      max-width: 34ch;
    }
    .programme-links {
      align-items: center;
    }
    .start-here-aside {
      text-align: center;
    }
    .posts-controls {
      flex-direction: column;
      align-items: center;
    }
    .lead-story .post-card-title,
    .lead-story .post-card-desc {
      max-width: none;
    }
    .lead-story {
      grid-template-columns: 1fr;
    }
    .lead-story-tags {
      margin-top: 0;
      max-width: none;
    }
    .posts-toolbar {
      justify-content: center;
    }
  }
  .view-toggle {
    flex-shrink: 0;
    background: none;
    border: 1px solid var(--line);
    border-radius: 0.625rem;
    padding: 0.45rem;
    cursor: pointer;
    color: var(--ink-muted);
    transition: border-color 0.2s, color 0.2s;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .view-toggle:hover {
    border-color: var(--accent);
    color: var(--foreground);
  }
  /* In cards mode: show list icon (to switch to list). In list mode: show grid icon (to switch to cards). */
  [data-view="cards"] .icon-grid { display: none; }
  [data-view="cards"] .icon-list { display: block; }
  [data-view="list"] .icon-grid { display: block; }
  [data-view="list"] .icon-list { display: none; }

  .post-card {
    display: block;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s, transform 0.2s, padding 0.3s ease, border-radius 0.3s ease;
  }
  .post-card:hover {
    border-color: rgba(30, 215, 96, 0.35);
    transform: translateY(-2px);
    text-decoration: none;
  }
  .post-card:hover .post-card-title {
    color: var(--accent);
  }
  .post-card-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.4rem;
    transition: margin 0.3s ease;
  }
  .post-card-date {
    font-size: 0.78rem;
    color: var(--ink-muted);
  }
  .post-card-reading-time {
    font-size: 0.78rem;
    color: var(--ink-muted);
  }
  .post-card-title {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 0.35rem;
    transition: font-size 0.3s ease, margin 0.3s ease;
  }
  .post-card-desc {
    font-size: 0.9rem;
    color: var(--ink-muted);
    line-height: 1.5;
    max-height: 12rem;
    overflow: hidden;
    transition: opacity 0.25s ease 0.05s, max-height 0.35s ease, margin 0.3s ease;
  }
  .post-card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.65rem;
    max-height: 5rem;
    overflow: hidden;
    transition: opacity 0.25s ease 0.05s, max-height 0.35s ease, margin 0.3s ease, gap 0.3s ease;
  }
  .tag {
    font-size: 0.72rem;
    padding: 0.15rem 0.55rem;
    border-radius: 2rem;
    border: 1px solid var(--line);
    color: var(--ink-muted);
    background: rgba(255,255,255,0.03);
  }

  /* Featured card: elevated glass with gradient overlay */
  .post-card-featured {
    position: relative;
    overflow: hidden;
