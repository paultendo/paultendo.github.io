---
import Base from "../layouts/Base.astro";
import "../styles/global.css";
import { getCollection } from "astro:content";
import { getReadingTime, formatReadingTime } from "../utils/readingTime";
import { sortPosts } from "../utils/sortPosts";

const now = new Date();
const posts = sortPosts(
  (await getCollection("posts")).filter((p) => !p.data.snapshot && new Date(p.data.date) <= now)
);
const allTags = [...new Set(posts.flatMap(p => p.data.tags || []))].sort();
---

<Base
  title="paultendo"
  description="Blog by Paul Wood FRSA. Open-source projects, technical writing, and building things."
>
  <section class="shell hero">
    <h1 class="display-type">paultendo</h1>
    <p class="hero-tagline">Open-source projects and technical writing by Paul Wood FRSA.</p>
    <div class="hero-links mono">
      <a href="https://github.com/paultendo/confusable-vision" target="_blank" rel="noopener">confusable-vision</a>
      <span class="sep" aria-hidden="true">&middot;</span>
      <a href="https://github.com/paultendo/namespace-guard" target="_blank" rel="noopener">namespace-guard</a>
    </div>
    <div class="hero-links mono">
      <a href="https://fiftysixlaw.co.uk" target="_blank" rel="noopener">Fifty Six Law</a>
      <span class="sep" aria-hidden="true">&middot;</span>
      <a href="https://cpaid.co.uk" target="_blank" rel="noopener">C-PAID</a>
      <span class="sep" aria-hidden="true">&middot;</span>
      <a href="https://getwill.co.uk" target="_blank" rel="noopener">GetWill</a>
      <span class="sep" aria-hidden="true">&middot;</span>
      <a href="https://github.com/paultendo" target="_blank" rel="noopener">GitHub</a>
      <span class="sep" aria-hidden="true">&middot;</span>
      <a href="https://www.linkedin.com/in/p-wood/" target="_blank" rel="noopener">LinkedIn</a>
    </div>
  </section>

  <section class="shell posts-section">
    <h2 class="sr-only">Posts</h2>
    <div id="posts-container" data-view="cards">
      <div class="posts-toolbar">
        <div class="tag-filter-bar">
          <button class="tag-pill tag-pill-active mono" data-tag="all">All</button>
          {allTags.map(tag => <button class="tag-pill mono" data-tag={tag}>{tag}</button>)}
        </div>
        <button id="view-toggle" class="view-toggle" aria-label="Toggle view mode">
          <svg class="icon-list" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="8" y1="6" x2="21" y2="6"></line>
            <line x1="8" y1="12" x2="21" y2="12"></line>
            <line x1="8" y1="18" x2="21" y2="18"></line>
            <line x1="3" y1="6" x2="3.01" y2="6"></line>
            <line x1="3" y1="12" x2="3.01" y2="12"></line>
            <line x1="3" y1="18" x2="3.01" y2="18"></line>
          </svg>
          <svg class="icon-grid" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="7" height="7"></rect>
            <rect x="14" y="3" width="7" height="7"></rect>
            <rect x="14" y="14" width="7" height="7"></rect>
            <rect x="3" y="14" width="7" height="7"></rect>
          </svg>
        </button>
      </div>
      <div class="posts-list">
        {posts.map((post) => {
          const formattedDate = new Date(post.data.date).toLocaleDateString("en-GB", {
            year: "numeric",
            month: "short",
            day: "numeric",
          });
          const updatedDate = post.data.updated
            ? new Date(post.data.updated).toLocaleDateString("en-GB", {
                year: "numeric",
                month: "short",
                day: "numeric",
              })
            : null;
          const readingTime = getReadingTime(post.body);
          const tags = post.data.tags || [];
          return (
            <a href={`/posts/${post.id}/`} class:list={["post-card", "glass-card", { "post-card-featured": post.data.featured }]} data-tags={tags.join(",")}>
              <div class="post-card-meta">
                <time datetime={post.data.date} class="post-card-date mono">
                  {formattedDate}{updatedDate && ` (updated ${updatedDate})`}
                </time>
                <span class="post-card-reading-time mono">{formatReadingTime(readingTime)}</span>
              </div>
              <h3 class="post-card-title display-type">{post.data.title}</h3>
              {post.data.featured && post.data.deck && (
                <p class="post-card-deck">{post.data.deck}</p>
              )}
              <p class="post-card-desc">{post.data.description}</p>
              {tags.length > 0 && (
                <div class="post-card-tags">
                  {tags.map((tag: string) => (
                    <span class="tag mono">{tag}</span>
                  ))}
                </div>
              )}
            </a>
          );
        })}
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding-top: clamp(1.5rem, 4vh, 3rem);
    padding-bottom: clamp(2rem, 4vh, 3rem);
    text-align: center;
  }
  .hero h1 {
    font-size: clamp(2.2rem, 5vw, 3.8rem);
    font-weight: 800;
    line-height: 1.1;
    margin-bottom: 1rem;
  }
  .hero-tagline {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(1rem, 1.8vw, 1.2rem);
    color: var(--ink-muted);
    max-width: 52ch;
    margin-inline: auto;
  }
  .hero-links {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1rem;
    font-size: 0.82rem;
  }
  .hero-links a {
    color: var(--ink-muted);
    text-decoration: none;
  }
  .hero-links a:hover {
    color: var(--accent);
  }
  .hero-links .sep {
    color: var(--line);
  }
  .posts-section {
    max-width: 48rem;
    margin-inline: auto;
    padding-bottom: 2rem;
  }
  .posts-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  /* Toolbar: tag bar + view toggle */
  .posts-toolbar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }
  .tag-filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    flex: 1;
  }
  .tag-pill {
    font-size: 0.72rem;
    padding: 0.2rem 0.6rem;
    border-radius: 2rem;
    border: 1px solid var(--line);
    color: var(--ink-muted);
    background: rgba(255,255,255,0.03);
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s, background 0.15s;
  }
  .tag-pill:hover {
    border-color: rgba(30, 215, 96, 0.35);
    color: var(--foreground);
  }
  .tag-pill-active {
    border-color: var(--accent);
    color: var(--accent);
    background: var(--accent-soft);
  }
  .view-toggle {
    flex-shrink: 0;
    background: none;
    border: 1px solid var(--line);
    border-radius: 0.625rem;
    padding: 0.45rem;
    cursor: pointer;
    color: var(--ink-muted);
    transition: border-color 0.2s, color 0.2s;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .view-toggle:hover {
    border-color: var(--accent);
    color: var(--foreground);
  }
  /* In cards mode: show list icon (to switch to list). In list mode: show grid icon (to switch to cards). */
  [data-view="cards"] .icon-grid { display: none; }
  [data-view="cards"] .icon-list { display: block; }
  [data-view="list"] .icon-grid { display: block; }
  [data-view="list"] .icon-list { display: none; }

  .post-card {
    display: block;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s, transform 0.2s, padding 0.3s ease, border-radius 0.3s ease;
  }
  .post-card:hover {
    border-color: rgba(30, 215, 96, 0.35);
    transform: translateY(-2px);
    text-decoration: none;
  }
  .post-card:hover .post-card-title {
    color: var(--accent);
  }
  .post-card-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.4rem;
    transition: margin 0.3s ease;
  }
  .post-card-date {
    font-size: 0.78rem;
    color: var(--ink-muted);
  }
  .post-card-reading-time {
    font-size: 0.78rem;
    color: var(--ink-muted);
  }
  .post-card-title {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 0.35rem;
    transition: font-size 0.3s ease, margin 0.3s ease;
  }
  .post-card-desc {
    font-size: 0.9rem;
    color: var(--ink-muted);
    line-height: 1.5;
    max-height: 12rem;
    overflow: hidden;
    transition: opacity 0.25s ease 0.05s, max-height 0.35s ease, margin 0.3s ease;
  }
  .post-card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.65rem;
    max-height: 5rem;
    overflow: hidden;
    transition: opacity 0.25s ease 0.05s, max-height 0.35s ease, margin 0.3s ease, gap 0.3s ease;
  }
  .tag {
    font-size: 0.72rem;
    padding: 0.15rem 0.55rem;
    border-radius: 2rem;
    border: 1px solid var(--line);
    color: var(--ink-muted);
    background: rgba(255,255,255,0.03);
  }

  /* Featured card: elevated glass with gradient overlay */
  .post-card-featured {
    position: relative;
    overflow: hidden;
    border-color: rgba(14, 30, 50, 0.18);
  }

  /* Radial gradient mesh overlay */
  .post-card-featured::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    border-radius: inherit;
    background:
      radial-gradient(ellipse at 18% 22%, rgba(22, 163, 74, 0.08) 0%, transparent 50%),
      radial-gradient(ellipse at 82% 78%, rgba(59, 130, 246, 0.06) 0%, transparent 50%);
  }

  /* Dark mode featured card */
  :global([data-theme="dark"]) .post-card-featured {
    background: linear-gradient(145deg, rgba(28, 39, 57, 0.92), rgba(11, 17, 27, 0.8));
    border-color: rgba(212, 230, 255, 0.22);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.12),
      0 18px 42px -24px rgba(0, 0, 0, 0.76);
  }

  :global([data-theme="dark"]) .post-card-featured::before {
    background:
      radial-gradient(ellipse at 18% 22%, rgba(30, 215, 96, 0.12) 0%, transparent 50%),
      radial-gradient(ellipse at 82% 78%, rgba(63, 121, 255, 0.09) 0%, transparent 50%);
  }

  /* Larger title for featured */
  .post-card-featured .post-card-title {
    font-size: 1.55rem;
  }

  /* Deck subtitle (only shown on featured) */
  .post-card-deck {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.92rem;
    color: var(--ink-muted);
    line-height: 1.5;
    margin-bottom: 0.5rem;
    max-height: 8rem;
    overflow: hidden;
    transition: opacity 0.25s ease 0.05s, max-height 0.35s ease, margin 0.3s ease;
  }

  /* List mode styles */
  [data-view="list"] .post-card {
    padding: 0.65rem 1rem;
    border-radius: 0.75rem;
  }
  [data-view="list"] .post-card-meta {
    margin-bottom: 0;
  }
  [data-view="list"] .post-card-title {
    font-size: 1rem;
    margin-bottom: 0;
  }
  [data-view="list"] .post-card-desc,
  [data-view="list"] .post-card-deck,
  [data-view="list"] .post-card-tags {
    opacity: 0;
    max-height: 0;
    overflow: hidden;
    margin: 0;
    padding: 0;
    gap: 0;
    transition: opacity 0.1s ease, max-height 0.25s ease 0.05s, margin 0.25s ease 0.05s, gap 0.25s ease 0.05s;
  }
  /* Featured in list mode: hide gradient overlay, subtle accent glow */
  [data-view="list"] .post-card-featured::before {
    display: none;
  }
  [data-view="list"] .post-card-featured {
    border-color: rgba(30, 215, 96, 0.25);
  }
  [data-view="list"] .post-card-featured .post-card-title {
    font-size: 1rem;
  }

</style>

<!-- FOUC prevention: apply saved view mode before paint -->
<script is:inline>
  (function() {
    var saved = localStorage.getItem('view-mode');
    if (saved === 'list' || saved === 'cards') {
      var el = document.getElementById('posts-container');
      if (el) el.setAttribute('data-view', saved);
    }
  })();
</script>

<script is:inline>
  (function() {
    var container = document.getElementById('posts-container');
    var toggle = document.getElementById('view-toggle');
    if (!container || !toggle) return;

    // View toggle
    toggle.addEventListener('click', function() {
      var current = container.getAttribute('data-view');
      var next = current === 'cards' ? 'list' : 'cards';
      container.setAttribute('data-view', next);
      localStorage.setItem('view-mode', next);
    });

    // Tag filtering
    var pills = document.querySelectorAll('.tag-pill');
    var cards = document.querySelectorAll('.post-card');

    function filterByTag(tag) {
      pills.forEach(function(p) {
        p.classList.toggle('tag-pill-active', p.getAttribute('data-tag') === tag);
      });
      cards.forEach(function(card) {
        if (tag === 'all') {
          card.style.display = '';
        } else {
          var cardTags = (card.getAttribute('data-tags') || '').split(',');
          card.style.display = cardTags.indexOf(tag) !== -1 ? '' : 'none';
        }
      });
    }

    pills.forEach(function(pill) {
      pill.addEventListener('click', function() {
        var tag = pill.getAttribute('data-tag');
        filterByTag(tag);
        if (tag === 'all') {
          history.replaceState(null, '', window.location.pathname);
        } else {
          history.replaceState(null, '', '#' + tag);
        }
      });
    });

    // Read hash on load
    var hash = window.location.hash.slice(1);
    if (hash) {
      var matching = document.querySelector('.tag-pill[data-tag="' + hash + '"]');
      if (matching) filterByTag(hash);
    }
  })();
</script>
