---
import Base from "../layouts/Base.astro";
import "../styles/global.css";
import { getCollection } from "astro:content";
import { getReadingTime, formatReadingTime } from "../utils/readingTime";
import { isPublishedPrimaryPost } from "../utils/postFilters";
import { SERIES } from "../utils/seriesData";
import { sortPosts } from "../utils/sortPosts";
import { TOOLS } from "../data/tools";
import ToolVisual from "../components/ToolVisual.astro";

const now = new Date();
const posts = sortPosts(
  (await getCollection("posts")).filter((p) => isPublishedPrimaryPost(p, now))
);
const unicodeSeries = SERIES.find((series) => series.id === "unicode-identifier-security");

function getEditorialTopics(post: (typeof posts)[number]): string[] {
  const tags = post.data.tags || [];
  const topics = new Set<string>();

  if (
    unicodeSeries?.posts.some((p) => p.id === post.id) ||
    tags.some((tag) => ["unicode", "security", "fonts", "identity"].includes(tag))
  ) {
    topics.add("unicode-security");
  }

  if (
    tags.some((tag) =>
      ["open-source", "npm", "typescript", "browser-extensions", "namespace-guard", "performance", "oncor"].includes(tag)
    )
  ) {
    topics.add("tools-and-infra");
  }

  if (
    tags.some((tag) =>
      ["ai", "legal-tech", "architecture", "opinion", "ai-music", "llm"].includes(tag)
    )
  ) {
    topics.add("applied-ai");
  }

  if (topics.size === 0) topics.add("notes");
  return [...topics];
}

const leadPost = posts.find((post) => post.data.featured) ?? posts[0];
const remainingPosts = posts.filter((post) => post.id !== leadPost.id);
const editorialSections = [
  {
    key: "unicode-security",
    label: "Unicode security",
    description: "The main research programme.",
    count: posts.filter((post) => getEditorialTopics(post).includes("unicode-security")).length,
  },
  {
    key: "tools-and-infra",
    label: "Tools and infrastructure",
    description: "Libraries, performance and systems work.",
    count: posts.filter((post) => getEditorialTopics(post).includes("tools-and-infra")).length,
  },
  {
    key: "applied-ai",
    label: "Applied AI systems",
    description: "Legal and product architecture.",
    count: posts.filter((post) => getEditorialTopics(post).includes("applied-ai")).length,
  },
];
---

<Base
  title="paultendo"
  description="Paul Wood FRSA on legal technology, open-source tools and Unicode security."
>
  <div class="shell home-frame">
    <section class="hero-v2">
      <p class="hero-kicker mono">Paul Wood FRSA</p>
      <h1 class="hero-line">Software that shows its working.</h1>
      <p class="hero-lede">
        I build legal technology, at <a href="https://fiftysixlaw.co.uk" target="_blank" rel="noopener">Fifty Six Law</a>
        and independently, alongside open-source tools and research into characters that pass for one another.
        Everything here is free to use and built in public.
      </p>
      <nav class="hero-links mono" aria-label="Elsewhere">
        <a href="/tools">Tools</a>
        <a href="#writing">Writing</a>
        <a href="https://github.com/paultendo" target="_blank" rel="noopener">GitHub</a>
        <a href="https://www.linkedin.com/in/p-wood/" target="_blank" rel="noopener">LinkedIn</a>
      </nav>
    </section>

    <section class="bento" aria-label="Work">
      {TOOLS.map((tool, index) => (
        <article class:list={["bento-tile", `bento-tile--${tool.id}`, { "bento-tile--lead": index === 0 }]}>
          <div class="bento-visual"><ToolVisual id={tool.id} /></div>
          <div class="bento-copy">
            <div class="bento-head">
              <h2 class="bento-name display-type">
                <a class="bento-primary" href={tool.primary.href} target={tool.primary.href.startsWith("http") ? "_blank" : undefined} rel={tool.primary.href.startsWith("http") ? "noopener" : undefined}>{tool.name}</a>
              </h2>
              <span class:list={["bento-badge", "mono", { "bento-badge--live": tool.live }]}>{tool.badge}</span>
            </div>
            <p class="bento-tagline">{tool.tagline}</p>
            <p class="bento-blurb">{tool.blurb}</p>
            <div class="bento-links mono">
              <span class="bento-go">{tool.primary.label} &rarr;</span>
              {tool.links.map((link) => (
                <a href={link.href} target={link.href.startsWith("http") ? "_blank" : undefined} rel={link.href.startsWith("http") ? "noopener" : undefined}>{link.label}</a>
              ))}
            </div>
          </div>
        </article>
      ))}
    </section>

    <section class="posts-section" id="writing">
      <div class="posts-heading">
        <h2 class="posts-title display-type">Writing</h2>
        <p class="posts-intro">Notes from the work: legal technology, the tools above, and the Unicode research behind them.</p>
      </div>
      <div id="posts-container" data-view="cards">
        <div class="posts-controls">
          <div class="section-filter-bar" aria-label="Editorial sections">
            <p class="filters-label mono">Browse by section</p>
            <button class="section-filter section-filter-active" data-topic="all">
              <span class="section-filter-label display-type">All posts</span>
              <span class="section-filter-meta mono">{posts.length}</span>
            </button>
            {editorialSections.map((section) => (
              <button class="section-filter" data-topic={section.key}>
                <span class="section-filter-label display-type">{section.label}</span>
                <span class="section-filter-meta mono">{section.count}</span>
              </button>
            ))}
          </div>
          <div class="posts-toolbar">
            <p class="filters-label mono">Display</p>
            <button id="view-toggle" class="view-toggle" aria-label="Toggle view mode">
              <svg class="icon-list" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="8" y1="6" x2="21" y2="6"></line>
                <line x1="8" y1="12" x2="21" y2="12"></line>
                <line x1="8" y1="18" x2="21" y2="18"></line>
                <line x1="3" y1="6" x2="3.01" y2="6"></line>
                <line x1="3" y1="12" x2="3.01" y2="12"></line>
                <line x1="3" y1="18" x2="3.01" y2="18"></line>
              </svg>
              <svg class="icon-grid" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="7" height="7"></rect>
                <rect x="14" y="3" width="7" height="7"></rect>
                <rect x="14" y="14" width="7" height="7"></rect>
                <rect x="3" y="14" width="7" height="7"></rect>
              </svg>
            </button>
          </div>
        </div>
        {leadPost && (() => {
          const formattedDate = new Date(leadPost.data.date).toLocaleDateString("en-GB", {
            year: "numeric",
            month: "short",
            day: "numeric",
          });
          const updatedDate = leadPost.data.updated
            ? new Date(leadPost.data.updated).toLocaleDateString("en-GB", {
                year: "numeric",
                month: "short",
                day: "numeric",
              })
            : null;
          const readingTime = getReadingTime(leadPost.body);
          const tags = leadPost.data.tags || [];
          const topics = getEditorialTopics(leadPost);
          const hasThumb = !!leadPost.data.thumbnail;
          return (
            <a href={`/posts/${leadPost.id}/`} class:list={["post-card", "lead-story", "glass-card", { "post-card-featured": leadPost.data.featured, "lead-story--has-thumb": hasThumb }]} data-topics={topics.join(",")}>
              <div class="lead-story-copy">
                <div class="post-card-meta">
                  <time datetime={leadPost.data.date} class="post-card-date mono">
                    {formattedDate}{updatedDate && ` (updated ${updatedDate})`}
                  </time>
                  <span class="post-card-reading-time mono">{formatReadingTime(readingTime)}</span>
                </div>
                <h3 class="post-card-title display-type">{leadPost.data.title}</h3>
                {leadPost.data.deck && (
                  <p class="post-card-deck">{leadPost.data.deck}</p>
                )}
                <p class="post-card-desc">{leadPost.data.description}</p>
                {tags.length > 0 && (
                  <div class="post-card-tags">
                    {tags.map((tag: string) => (
                      <span class="tag mono">{tag}</span>
                    ))}
                  </div>
                )}
                <p class="lead-story-cta mono">Read featured post</p>
              </div>
              {hasThumb && (
                <div class="lead-story-thumb">
                  <img src={leadPost.data.thumbnail} alt="" loading="lazy" />
                </div>
              )}
            </a>
          );
        })()}
        <div class="posts-list">
          {remainingPosts.map((post) => {
            const formattedDate = new Date(post.data.date).toLocaleDateString("en-GB", {
              year: "numeric",
              month: "short",
              day: "numeric",
            });
            const updatedDate = post.data.updated
              ? new Date(post.data.updated).toLocaleDateString("en-GB", {
                  year: "numeric",
                  month: "short",
                  day: "numeric",
                })
              : null;
            const readingTime = getReadingTime(post.body);
            const tags = post.data.tags || [];
            const topics = getEditorialTopics(post);
            const hasThumb = !!post.data.thumbnail;
            return (
              <a href={`/posts/${post.id}/`} class:list={["post-card", "glass-card", { "post-card-featured": post.data.featured, "post-card--has-thumb": hasThumb }]} data-topics={topics.join(",")}>
                <div class="post-card-body">
                  <div class="post-card-meta">
                    <time datetime={post.data.date} class="post-card-date mono">
                      {formattedDate}{updatedDate && ` (updated ${updatedDate})`}
                    </time>
                    <span class="post-card-reading-time mono">{formatReadingTime(readingTime)}</span>
                  </div>
                  <h3 class="post-card-title display-type">{post.data.title}</h3>
                  {post.data.featured && post.data.deck && (
                    <p class="post-card-deck">{post.data.deck}</p>
                  )}
                  <p class="post-card-desc">{post.data.description}</p>
                  {tags.length > 0 && (
                    <div class="post-card-tags">
                      {tags.map((tag: string) => (
                        <span class="tag mono">{tag}</span>
                      ))}
                    </div>
                  )}
                </div>
                {hasThumb && (
                  <div class="post-card-thumb">
                    <img src={post.data.thumbnail} alt="" loading="lazy" />
                  </div>
                )}
              </a>
            );
          })}
        </div>
      </div>
    </section>
  </div>
</Base>

<style>
  .home-frame {
    max-width: var(--layout-frame-width);
    margin-inline: auto;
  }
  /* Hero: one line of intent, set in the serif */
  .hero-v2 {
    padding: clamp(3rem, 9vh, 6.5rem) 0 clamp(2.25rem, 5vh, 3.5rem);
    max-width: 46rem;
  }
  .hero-kicker {
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    color: var(--ink-muted);
    margin: 0 0 1.1rem;
  }
  .hero-line {
    font-family: var(--font-serif);
    font-optical-sizing: auto;
    font-weight: 400;
    font-size: clamp(2.5rem, 6vw, 4.6rem);
    line-height: 1;
    letter-spacing: -0.035em;
    margin: 0 0 1.35rem;
    text-wrap: balance;
  }
  .hero-lede {
    font-size: clamp(1.02rem, 1.4vw, 1.15rem);
    line-height: 1.65;
    color: var(--ink-muted);
    max-width: 40rem;
    margin: 0 0 1.4rem;
    text-wrap: pretty;
  }
  .hero-lede a {
    color: var(--foreground);
    text-decoration: underline;
    text-decoration-color: var(--line);
    text-underline-offset: 3px;
  }
  .hero-lede a:hover {
    text-decoration-color: var(--accent);
  }
  .hero-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.4rem;
    font-size: 0.8rem;
  }
  .hero-links a {
    color: var(--ink-muted);
    text-decoration: none;
  }
  .hero-links a:hover {
    color: var(--accent);
  }

  /* Work: a bento of the tools, each with its own picture */
  .bento {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 14px;
    margin-bottom: clamp(3.5rem, 8vh, 5.5rem);
  }
  .bento-tile {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    padding: 14px 14px 18px;
    border-radius: 18px;
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--foreground) 2.5%, transparent);
    transition: border-color 0.2s ease-out, transform 0.2s ease-out, background 0.2s ease-out;
    grid-column: span 3;
  }
  .bento-tile:hover {
    border-color: color-mix(in srgb, var(--accent) 45%, var(--line));
    background: color-mix(in srgb, var(--foreground) 3.5%, transparent);
    transform: translateY(-2px);
  }
  .bento-tile--lead {
    grid-column: span 4;
    grid-row: span 2;
  }
  .bento-tile--confusable-vision {
    grid-column: span 2;
    grid-row: span 2;
  }
  .bento-visual {
    height: 14.5rem;
  }
  .bento-tile--lead .bento-visual {
    height: auto;
    flex: 1;
    min-height: 19rem;
  }
  .bento-tile--confusable-vision .bento-visual {
    height: auto;
    flex: 1;
    min-height: 15rem;
  }
  .bento-copy {
    padding: 0 6px;
  }
  .bento-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.35rem;
  }
  .bento-name {
    font-size: 1.2rem;
    font-weight: 700;
    line-height: 1.15;
    white-space: nowrap;
    margin: 0;
  }
  .bento-tile--lead .bento-name {
    font-size: 1.5rem;
  }
  .bento-primary {
    color: var(--foreground);
    text-decoration: none;
  }
  /* The whole tile opens the tool; its other links sit above that */
  .bento-primary::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 18px;
  }
  .bento-tile:hover .bento-primary {
    color: var(--accent);
  }
  .bento-badge {
    flex: none;
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.18rem 0.55rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    color: var(--ink-muted);
    white-space: nowrap;
  }
  .bento-badge--live {
    color: var(--accent);
    border-color: color-mix(in srgb, var(--accent) 40%, transparent);
    background: color-mix(in srgb, var(--accent) 8%, transparent);
  }
  .bento-tagline {
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--foreground);
    margin: 0 0 0.3rem;
  }
  .bento-blurb {
    color: var(--ink-muted);
    font-size: 0.92rem;
    line-height: 1.55;
    margin: 0 0 0.85rem;
    text-wrap: pretty;
  }
  .bento-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.1rem;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .bento-go {
    color: var(--accent);
  }
  .bento-links a {
    position: relative;
    z-index: 1;
    color: var(--ink-muted);
    text-decoration: none;
  }
  .bento-links a:hover {
    color: var(--foreground);
  }
  @media (max-width: 900px) {
    .bento-tile,
    .bento-tile--lead,
    .bento-tile--confusable-vision {
      grid-column: span 6;
      grid-row: auto;
    }
    .bento-tile--lead .bento-visual,
    .bento-tile--confusable-vision .bento-visual {
      min-height: 13rem;
    }
  }

  .posts-section {
    padding-bottom: 2rem;
  }
  .posts-heading {
    max-width: 48rem;
    margin-bottom: 1rem;
  }
  .posts-title {
    font-size: clamp(1.6rem, 3vw, 2.5rem);
    line-height: 1.1;
    margin-bottom: 0.35rem;
    text-wrap: balance;
  }
  .posts-intro {
    color: var(--ink-muted);
    text-wrap: pretty;
    max-width: 46rem;
  }
  .posts-controls {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem 1.5rem;
    margin-bottom: 1rem;
  }
  .section-filter-bar {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.45rem 0.5rem;
  }
  .section-filter {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    text-align: left;
    padding: 0.3rem 0.55rem 0.38rem;
    border: 1px solid rgba(14, 30, 50, 0.08);
    border-radius: 999px;
    background: transparent;
    color: inherit;
    cursor: pointer;
    transition: border-color 0.2s ease-out, background 0.2s ease-out, transform 0.2s ease-out;
  }
  .section-filter:hover {
    border-color: rgba(30, 215, 96, 0.26);
    background: rgba(30, 215, 96, 0.04);
  }
  .section-filter-active {
    border-color: rgba(30, 215, 96, 0.36);
    background: rgba(30, 215, 96, 0.08);
  }
  .section-filter-label {
    font-size: 0.78rem;
    line-height: 1;
  }
  .section-filter-meta {
    color: var(--accent);
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .lead-story {
    display: block;
    margin-bottom: 1.25rem;
    padding: clamp(1.75rem, 2.8vw, 2.5rem);
  }
  .lead-story-copy {
    min-width: 0;
    max-width: none;
  }
  .lead-story .post-card-title {
    font-size: clamp(1.95rem, 3.5vw, 2.8rem);
    line-height: 1.05;
    max-width: none;
    text-wrap: pretty;
  }
  .lead-story .post-card-desc {
    font-size: 1rem;
  }
  .lead-story-cta {
    margin-top: 1rem;
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .lead-story-thumb {
    position: relative;
    align-self: start;
    border-radius: 0.75rem;
    overflow: hidden;
    max-height: 12rem;
  }
  .lead-story-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: saturate(0.7) contrast(1.1);
    transition: filter 0.2s cubic-bezier(0.22, 0.61, 0.36, 1), transform 0.2s cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  .lead-story:hover .lead-story-thumb img {
    filter: saturate(0.85) contrast(1.05);
    transform: scale(1.03);
  }
  .lead-story-thumb::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(10, 18, 30, 0.45) 0%, transparent 60%);
    pointer-events: none;
  }
  :global([data-theme="dark"]) .lead-story-thumb::after {
    background: linear-gradient(135deg, rgba(5, 10, 20, 0.6) 0%, transparent 60%);
  }
  .lead-story--has-thumb {
    display: grid;
    grid-template-columns: 1fr 9rem;
    align-items: start;
    gap: 1.2rem 1.4rem;
  }
  .lead-story-tags {
    align-self: start;
    align-content: start;
    margin-top: 2.3rem;
    max-width: none;
    max-height: none;
    overflow: visible;
  }
  .posts-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  /* Toolbar: tag bar + view toggle */
  .posts-toolbar {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.75rem 1rem;
    padding: 0;
    flex-shrink: 0;
  }
  .filters-label {
    flex-shrink: 0;
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  :global([data-theme="dark"]) .programme-strip {
    border-color: rgba(212, 230, 255, 0.16);
    background: rgba(8, 16, 28, 0.34);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.06);
  }
  :global([data-theme="dark"]) .start-here-card {
    border-color: rgba(30, 215, 96, 0.22);
    background: linear-gradient(145deg, rgba(15, 28, 26, 0.7), rgba(10, 16, 27, 0.58));
  }
  :global([data-theme="dark"]) .programme-block + .programme-block {
    border-left-color: rgba(212, 230, 255, 0.1);
  }
  :global([data-theme="dark"]) .section-filter {
    border-color: rgba(212, 230, 255, 0.14);
    background: rgba(255,255,255,0.025);
  }
  @media (max-width: 980px) {
    .hero {
      max-width: none;
    }
    .programme-strip {
      grid-template-columns: 1fr;
      gap: 0.8rem;
    }
    .start-here-card,
    .start-here-card--has-thumb {
      grid-template-columns: 1fr;
    }
    .start-here-thumb {
      min-height: 8rem;
      border-radius: 0.5rem;
    }
    .start-here-aside {
      text-align: left;
    }
    .programme-block + .programme-block {
      padding-left: 0;
      padding-top: 0.8rem;
      border-left: 0;
      border-top: 1px solid rgba(14, 30, 50, 0.08);
    }
    :global([data-theme="dark"]) .programme-block + .programme-block {
      border-top-color: rgba(212, 230, 255, 0.1);
    }
  }
  @media (max-width: 720px) {
    .hero,
    .posts-section,
    .programme-strip,
    .start-here-card {
      text-align: center;
    }
    .hero-tagline {
      max-width: 32ch;
    }
    .hero-intro,
    .posts-intro {
      max-width: 34ch;
    }
    .programme-links {
      align-items: center;
    }
    .start-here-aside {
      text-align: center;
    }
    .posts-controls {
      flex-direction: column;
      align-items: center;
    }
    .lead-story .post-card-title,
    .lead-story .post-card-desc {
      max-width: none;
    }
    .lead-story,
    .lead-story--has-thumb {
      grid-template-columns: 1fr;
    }
    .lead-story-thumb {
      min-height: 10rem;
      border-radius: 0.5rem;
    }
    .post-card--has-thumb {
      grid-template-columns: 1fr;
    }
    .post-card-thumb {
      min-height: 8rem;
      border-radius: 0.5rem;
      order: -1;
    }
    .lead-story-tags {
      margin-top: 0;
      max-width: none;
    }
    .posts-toolbar {
      justify-content: center;
    }
  }
