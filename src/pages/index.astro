<!-- FOUC prevention: apply saved view mode before paint -->
<script is:inline>
  (function() {
    var saved = localStorage.getItem('view-mode');
    if (saved === 'list' || saved === 'cards') {
      var el = document.getElementById('posts-container');
      if (el) el.setAttribute('data-view', saved);
    }
  })();
</script>

<script is:inline>
  (function() {
    var container = document.getElementById('posts-container');
    var toggle = document.getElementById('view-toggle');
    if (!container || !toggle) return;

    // View toggle
    toggle.addEventListener('click', function() {
      var current = container.getAttribute('data-view');
      var next = current === 'cards' ? 'list' : 'cards';
      container.setAttribute('data-view', next);
      localStorage.setItem('view-mode', next);
    });

    // Section filtering
    var filters = document.querySelectorAll('.section-filter');
    var cards = document.querySelectorAll('.post-card');

    function filterByTopic(topic) {
      filters.forEach(function(filter) {
        filter.classList.toggle('section-filter-active', filter.getAttribute('data-topic') === topic);
      });
      cards.forEach(function(card) {
        if (topic === 'all') {
          card.style.display = '';
        } else {
          var cardTopics = (card.getAttribute('data-topics') || '').split(',');
          card.style.display = cardTopics.indexOf(topic) !== -1 ? '' : 'none';
        }
      });
    }

    filters.forEach(function(filter) {
      filter.addEventListener('click', function() {
        var topic = filter.getAttribute('data-topic');
        filterByTopic(topic);
        if (topic === 'all') {
          history.replaceState(null, '', window.location.pathname);
        } else {
          history.replaceState(null, '', '#' + topic);
        }
      });
    });

    // Read hash on load
    var hash = window.location.hash.slice(1);
    if (hash) {
      var matching = document.querySelector('.section-filter[data-topic="' + hash + '"]');
      if (matching) filterByTopic(hash);
    }
  })();
</script>
