---
import Base from "../layouts/Base.astro";
import "../styles/global.css";
import { getCollection } from "astro:content";
import { getReadingTime, formatReadingTime } from "../utils/readingTime";
import { sortPosts } from "../utils/sortPosts";

const now = new Date();
const posts = sortPosts(
  (await getCollection("posts")).filter((p) => !p.data.snapshot && new Date(p.data.date) <= now)
);
---

<Base
  title="paultendo"
  description="Blog by Paul Wood FRSA. Open-source projects, technical writing, and building things."
>
  <section class="shell hero">
    <h1 class="display-type">paultendo</h1>
    <p class="hero-tagline">Open-source projects and technical writing by Paul Wood FRSA.</p>
    <div class="hero-links mono">
      <a href="https://fiftysixlaw.co.uk" target="_blank" rel="noopener">Fifty Six Law</a>
      <span class="sep" aria-hidden="true">&middot;</span>
      <a href="https://cpaid.co.uk" target="_blank" rel="noopener">C-PAID</a>
      <span class="sep" aria-hidden="true">&middot;</span>
      <a href="https://getwill.co.uk" target="_blank" rel="noopener">GetWill</a>
      <span class="sep" aria-hidden="true">&middot;</span>
      <a href="https://github.com/paultendo" target="_blank" rel="noopener">GitHub</a>
      <span class="sep" aria-hidden="true">&middot;</span>
      <a href="https://www.linkedin.com/in/p-wood/" target="_blank" rel="noopener">LinkedIn</a>
    </div>
  </section>

  <section class="shell posts-section">
    <h2 class="sr-only">Posts</h2>
    {posts.map((post) => {
      const formattedDate = new Date(post.data.date).toLocaleDateString("en-GB", {
        year: "numeric",
        month: "short",
        day: "numeric",
      });
      const updatedDate = post.data.updated
        ? new Date(post.data.updated).toLocaleDateString("en-GB", {
            year: "numeric",
            month: "short",
            day: "numeric",
          })
        : null;
      const readingTime = getReadingTime(post.body);
      return (
        <a href={`/posts/${post.id}/`} class:list={["post-card", "glass-card", { "post-card-featured": post.data.featured }]}>
          <div class="post-card-meta">
            <time datetime={post.data.date} class="post-card-date mono">
              {formattedDate}{updatedDate && ` (updated ${updatedDate})`}
            </time>
            <span class="post-card-reading-time mono">{formatReadingTime(readingTime)}</span>
          </div>
          <h3 class="post-card-title display-type">{post.data.title}</h3>
          {post.data.featured && post.data.deck && (
            <p class="post-card-deck">{post.data.deck}</p>
          )}
          <p class="post-card-desc">{post.data.description}</p>
          {post.data.tags && (
            <div class="post-card-tags">
              {post.data.tags.map((tag: string) => (
                <span class="tag mono">{tag}</span>
              ))}
            </div>
          )}
        </a>
      );
    })}
  </section>
</Base>

<style>
  .hero {
    padding-top: clamp(3rem, 8vh, 6rem);
    padding-bottom: clamp(2rem, 4vh, 3rem);
    text-align: center;
  }
  .hero h1 {
    font-size: clamp(2.2rem, 5vw, 3.8rem);
    font-weight: 800;
    line-height: 1.1;
    margin-bottom: 1rem;
  }
  .hero-tagline {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(1rem, 1.8vw, 1.2rem);
    color: var(--ink-muted);
    max-width: 52ch;
    margin-inline: auto;
  }
  .hero-links {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1rem;
    font-size: 0.82rem;
  }
  .hero-links a {
    color: var(--ink-muted);
    text-decoration: none;
  }
  .hero-links a:hover {
    color: var(--accent);
  }
  .hero-links .sep {
    color: var(--line);
  }
  .posts-section {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 48rem;
    margin-inline: auto;
    padding-bottom: 2rem;
  }
  .post-card {
    display: block;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s, transform 0.2s;
  }
  .post-card:hover {
    border-color: rgba(30, 215, 96, 0.35);
    transform: translateY(-2px);
    text-decoration: none;
  }
  .post-card:hover .post-card-title {
    color: var(--accent);
  }
  .post-card-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.4rem;
  }
  .post-card-date {
    font-size: 0.78rem;
    color: var(--ink-muted);
  }
  .post-card-reading-time {
    font-size: 0.78rem;
    color: var(--ink-muted);
  }
  .post-card-title {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 0.35rem;
  }
  .post-card-desc {
    font-size: 0.9rem;
    color: var(--ink-muted);
    line-height: 1.5;
  }
  .post-card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.65rem;
  }
  .tag {
    font-size: 0.72rem;
    padding: 0.15rem 0.55rem;
    border-radius: 2rem;
    border: 1px solid var(--line);
    color: var(--ink-muted);
    background: rgba(255,255,255,0.03);
  }

  /* Featured card: elevated glass with gradient overlay */
  .post-card-featured {
    position: relative;
    overflow: hidden;
    border-color: rgba(14, 30, 50, 0.18);
  }

  /* Radial gradient mesh overlay */
  .post-card-featured::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    border-radius: inherit;
    background:
      radial-gradient(ellipse at 18% 22%, rgba(22, 163, 74, 0.08) 0%, transparent 50%),
      radial-gradient(ellipse at 82% 78%, rgba(59, 130, 246, 0.06) 0%, transparent 50%);
  }

  /* Dark mode featured card */
  :global([data-theme="dark"]) .post-card-featured {
    background: linear-gradient(145deg, rgba(28, 39, 57, 0.92), rgba(11, 17, 27, 0.8));
    border-color: rgba(212, 230, 255, 0.22);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.12),
      0 18px 42px -24px rgba(0, 0, 0, 0.76);
  }

  :global([data-theme="dark"]) .post-card-featured::before {
    background:
      radial-gradient(ellipse at 18% 22%, rgba(30, 215, 96, 0.12) 0%, transparent 50%),
      radial-gradient(ellipse at 82% 78%, rgba(63, 121, 255, 0.09) 0%, transparent 50%);
  }

  /* Larger title for featured */
  .post-card-featured .post-card-title {
    font-size: 1.55rem;
  }

  /* Deck subtitle (only shown on featured) */
  .post-card-deck {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.92rem;
    color: var(--ink-muted);
    line-height: 1.5;
    margin-bottom: 0.5rem;
  }

</style>
