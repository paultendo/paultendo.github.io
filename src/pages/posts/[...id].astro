---
import { getCollection, render } from "astro:content";
import Post from "../../layouts/Post.astro";
import "../../styles/global.css";
import { isPublishedPost } from "../../utils/postFilters";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  const now = new Date();
  const publishedPosts = posts.filter((post) => isPublishedPost(post, now));
  return publishedPosts.map((post) => ({
    params: { id: post.id },
    props: { post, allPosts: publishedPosts },
  }));
}

const { post, allPosts } = Astro.props;
const { Content, headings } = await render(post);
const ogImage = post.data.snapshot ? undefined : `${Astro.site}og/${post.id}.png`;
---

<Post frontmatter={{ ...post.data, ogImage }} headings={headings} rawContent={() => post.body} allPosts={allPosts} currentPostId={post.id}>
  <Content />
</Post>
