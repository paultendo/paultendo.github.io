---
import Base from "./Base.astro";
import TableOfContents from "../components/TableOfContents.astro";
import SidebarToC from "../components/SidebarToC.astro";
import UpdateBanner from "../components/UpdateBanner.astro";
import SeriesNav from "../components/SeriesNav.astro";
import { getReadingTime, formatReadingTime } from "../utils/readingTime";
import { sortPosts } from "../utils/sortPosts";
import { getSeriesForPost } from "../utils/seriesData";

interface Props {
  frontmatter: {
    title: string;
    deck?: string;
    description: string;
    date: string;
    tags?: string[];
    ogImage?: string;
    updated?: string;
    updateNote?: string;
    order?: number;
    snapshot?: boolean;
    snapshotOf?: string;
  };
  rawContent: () => string;
  headings: { depth: number; slug: string; text: string }[];
  allPosts?: any[];
  currentPostId?: string;
}

const { frontmatter, rawContent, headings, allPosts = [], currentPostId } = Astro.props;

const isSnapshot = frontmatter.snapshot === true;

const otherPosts = sortPosts(
  allPosts.filter((p) => p.id !== currentPostId && !p.data.snapshot)
).slice(0, 2);

// Find the most recent snapshot for an updated post
let snapshotLink: string | undefined;
if (frontmatter.updated && currentPostId) {
  const snapshots = allPosts
    .filter((p) => p.data.snapshotOf === currentPostId)
    .sort((a, b) => b.id.localeCompare(a.id));
  if (snapshots.length > 0) {
    snapshotLink = `/posts/${snapshots[0].id}/`;
  }
}

const formattedDate = new Date(frontmatter.date).toLocaleDateString("en-GB", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const readingTime = getReadingTime(rawContent());
const showToc = headings.filter(h => h.depth === 2).length >= 3;

// Series navigation
const seriesInfo = currentPostId ? getSeriesForPost(currentPostId) : null;
let seriesNav: { seriesTitle: string; currentIndex: number; totalPosts: number; prevPost?: { slug: string; title: string }; nextPost?: { slug: string; title: string } } | null = null;
if (seriesInfo) {
  const { series, index } = seriesInfo;
  const prevSlug = index > 0 ? series.posts[index - 1] : undefined;
  const nextSlug = index < series.posts.length - 1 ? series.posts[index + 1] : undefined;
  const findTitle = (slug: string) => allPosts.find((p: any) => p.id === slug)?.data?.title || slug;
  seriesNav = {
    seriesTitle: series.title,
    currentIndex: index,
    totalPosts: series.posts.length,
    prevPost: prevSlug ? { slug: prevSlug, title: findTitle(prevSlug) } : undefined,
    nextPost: nextSlug ? { slug: nextSlug, title: findTitle(nextSlug) } : undefined,
  };
}
---

<Base title={frontmatter.title} description={frontmatter.description} ogImage={frontmatter.ogImage} canonicalPath={isSnapshot && frontmatter.snapshotOf ? `/posts/${frontmatter.snapshotOf}/` : undefined}>
  <article class={`shell post ${showToc ? 'post--has-toc' : ''}`}>
    <header class="post-header">
      <div class="post-meta">
        <time datetime={frontmatter.date} class="post-date mono">
          {formattedDate}{frontmatter.updated && ` (updated ${new Date(frontmatter.updated).toLocaleDateString("en-GB", { year: "numeric", month: "long", day: "numeric" })})`}
        </time>
        <span class="post-reading-time mono">{formatReadingTime(readingTime)}</span>
      </div>
      <h1 class="display-type">{frontmatter.title}</h1>
      {frontmatter.deck && (
        <p class="post-deck">{frontmatter.deck}</p>
      )}
      {frontmatter.tags && (
        <div class="post-tags">
          {frontmatter.tags.map((tag: string) => (
            <span class="tag mono">{tag}</span>
          ))}
        </div>
      )}
    </header>
    {isSnapshot && frontmatter.snapshotOf && (
      <UpdateBanner
        mode="snapshot"
        date={frontmatter.date}
        linkTo={`/posts/${frontmatter.snapshotOf}/`}
      />
    )}
    {frontmatter.updated && snapshotLink && (
      <UpdateBanner
        mode="updated"
        date={frontmatter.updated}
        updateNote={frontmatter.updateNote}
        linkTo={snapshotLink}
      />
    )}
    <div class="prose">
      <TableOfContents headings={headings} />
      <slot />
    </div>
    {showToc && (
      <div class="sidebar-toc-col">
        <SidebarToC headings={headings} />
      </div>
    )}
    {seriesNav && (
      <SeriesNav
        seriesTitle={seriesNav.seriesTitle}
        currentIndex={seriesNav.currentIndex}
        totalPosts={seriesNav.totalPosts}
        prevPost={seriesNav.prevPost}
        nextPost={seriesNav.nextPost}
      />
    )}
    {!isSnapshot && otherPosts.length > 0 && (
      <aside class="more-posts" aria-label="More posts">
        <div class="divider"></div>
        <h2 class="more-posts-heading">More posts</h2>
        <div class="more-posts-grid">
          {otherPosts.map((p) => {
            const date = new Date(p.data.date).toLocaleDateString("en-GB", {
              year: "numeric",
              month: "short",
              day: "numeric",
            });
            const rt = getReadingTime(p.body);
            return (
              <a href={`/posts/${p.id}/`} class="more-post-card glass-card">
                <div class="more-post-meta">
                  <time datetime={p.data.date} class="mono">{date}</time>
                  <span class="mono">{formatReadingTime(rt)}</span>
                </div>
                <h3 class="more-post-title display-type">{p.data.title}</h3>
                <p class="more-post-desc">{p.data.description}</p>
              </a>
            );
          })}
        </div>
      </aside>
    )}
  </article>
</Base>

<style>
  .post {
    padding-top: clamp(2rem, 6vh, 4rem);
  }
  .post-header {
    max-width: 68ch;
    margin-inline: auto;
    margin-bottom: 1.25rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid transparent;
    border-image: linear-gradient(90deg, transparent, var(--line), transparent) 1;
  }
  .post-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.25rem 1rem;
    margin-bottom: 0.75rem;
  }
  .post-date {
    font-size: 0.82rem;
    color: var(--ink-muted);
  }
  .post-reading-time {
    font-size: 0.82rem;
    color: var(--ink-muted);
  }
  .post-header h1 {
    font-size: clamp(2rem, 4.5vw, 3rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }
  .post-deck {
    font-size: clamp(1.1rem, 2.2vw, 1.35rem);
    font-weight: 400;
    line-height: 1.4;
    color: var(--ink-muted);
    margin-top: 0.75rem;
    margin-bottom: 0;
    font-style: italic;
  }
  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 1rem;
  }
  .tag {
    font-size: 0.75rem;
    padding: 0.2rem 0.6rem;
    border-radius: 2rem;
    border: 1px solid var(--line);
    color: var(--ink-muted);
    background: rgba(255,255,255,0.03);
  }
  @media (min-width: 1200px) {
    .post--has-toc {
      display: grid;
      grid-template-columns: 1fr min(68ch, calc(100% - 260px)) 220px;
      grid-template-rows: auto 1fr auto;
      column-gap: 2rem;
    }
    .post--has-toc .post-header {
      grid-column: 2;
      max-width: none;
      margin-inline: 0;
      margin-bottom: 1rem;
      padding-bottom: 0.75rem;
    }
    .post--has-toc .prose {
      grid-column: 2;
      max-width: none;
      margin-inline: 0;
    }
    .post--has-toc .sidebar-toc-col {
      grid-column: 3;
      grid-row: 1 / -1;
      align-self: start;
      position: sticky;
      top: 2rem;
    }
    .post--has-toc :global(.update-banner) {
      grid-column: 2;
      max-width: none;
      margin-inline: 0;
    }
    .post--has-toc .more-posts {
      grid-column: 2;
      max-width: none;
    }
    .post--has-toc :global(.series-nav) {
      grid-column: 2;
      max-width: none;
    }
  }
  .more-posts {
    max-width: 68ch;
    margin-inline: auto;
    padding-bottom: 1rem;
  }
  .more-posts-heading {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    font-size: 1.35rem;
    color: var(--ink-muted);
    margin-bottom: 1rem;
  }
  .more-posts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 1rem;
  }
  .more-post-card {
    display: block;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s, transform 0.2s;
  }
  .more-post-card:hover {
    border-color: rgba(30, 215, 96, 0.35);
    transform: translateY(-2px);
    text-decoration: none;
  }
  .more-post-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.4rem;
    font-size: 0.78rem;
    color: var(--ink-muted);
  }
  .more-post-title {
    font-size: 1.15rem;
    font-weight: 700;
    margin-bottom: 0.3rem;
  }
  .more-post-desc {
    font-size: 0.85rem;
    color: var(--ink-muted);
    line-height: 1.5;
  }

</style>

<script is:inline>
  // Language labels and copy buttons for code blocks
  (function() {
    var pres = document.querySelectorAll('.prose pre:not(.mermaid)');
    pres.forEach(function(pre) {
      var lang = pre.getAttribute('data-language');
      if (lang) {
        var label = document.createElement('span');
        label.className = 'code-lang mono';
        label.textContent = lang;
        pre.appendChild(label);
      }
      var copyIcon = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>';
      var checkIcon = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>';
      var btn = document.createElement('button');
      btn.className = 'copy-btn';
      btn.innerHTML = copyIcon;
      btn.setAttribute('aria-label', 'Copy code to clipboard');
      btn.addEventListener('click', function() {
        var code = pre.querySelector('code');
        var text = code ? code.textContent : pre.textContent;
        navigator.clipboard.writeText(text).then(function() {
          btn.innerHTML = checkIcon;
          btn.classList.add('copy-btn-success');
          setTimeout(function() {
            btn.innerHTML = copyIcon;
            btn.classList.remove('copy-btn-success');
          }, 1500);
        });
      });
      pre.appendChild(btn);
    });
  })();
</script>
